cmd_help() {
  echo "${BOLD}manage-skills${RESET} v$VERSION — Hardlink-based skill sharing across projects

${BOLD}USAGE${RESET}
  manage-skills                    Interactive mode (fzf or menu)
  manage-skills list               List all available skills
  manage-skills locations          Show where skills come from, per source
  manage-skills link <skill>...    Hardlink skills into current project
  manage-skills unlink <skill>...  Remove skills from current project
  manage-skills sync               Re-hardlink stale copies
  manage-skills check              Verify hardlink integrity

${BOLD}SELF${RESET}
  manage-skills self               Where this install and its own skills live
  manage-skills self install       Register the shipped skills as a source
  manage-skills self update        Update the script and the shipped skills

${BOLD}CONFIG${RESET}
  manage-skills init               Create ~/.manage-skills/ config
  manage-skills sources            List source directories
  manage-skills sources add <dir> [label]
                                   Add a skill source, with an optional label
  manage-skills sources remove <dir>
  manage-skills targets            List configured targets
  manage-skills targets add <name> <path> <file>

${BOLD}OPTIONS${RESET}
  --target, -t <name>   Target type (default: claude)
  --version             Show version
  --help, -h            Show this help

${BOLD}CONFIG FILES${RESET}
  ~/.manage-skills/sources   Skill source directories, one per line, each with
                             an optional trailing '# label'
  ~/.manage-skills/targets   Target definitions (name:path:file)
  ~/.manage-skills/notes.md  Optional free-form notes, appended to 'locations'

${BOLD}EXAMPLES${RESET}
  manage-skills init
  manage-skills sources add ~/dev/shared-skills Cross-language: K8s, CI, tools
  manage-skills sources add ~/dev/perl/shared-skills Shared Perl ecosystem
  manage-skills locations                   # where does everything come from?
  cd ~/my-project && manage-skills          # interactive
  manage-skills link perl-moo dbio-core     # link specific skills
  manage-skills check                       # verify everything"
}

ensure_config

case "${1:-}" in
  "")           cmd_interactive ;;
  init)         cmd_init ;;
  list)         shift; cmd_list "$@" ;;
  locations)    shift; cmd_locations "$@" ;;
  self)         shift; cmd_self "$@" ;;
  selfupdate)   shift; cmd_self update "$@" ;;
  link)         shift; cmd_link "$@" ;;
  unlink)       shift; cmd_unlink "$@" ;;
  sync)         shift; cmd_sync "$@" ;;
  check)        shift; cmd_check "$@" ;;
  sources)      shift; cmd_sources "$@" ;;
  targets)      shift; cmd_targets "$@" ;;
  --version)    echo "manage-skills $VERSION" ;;
  --help|-h)    cmd_help ;;
  *)            die "Unknown command: $1. Run manage-skills --help" ;;
esac
