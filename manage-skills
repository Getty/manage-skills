#!/usr/bin/env bash
set -euo pipefail

VERSION="0.9.0"
SELF_REPO="${MANAGE_SKILLS_REPO:-Getty/manage-skills}"
# Skills this tool ships. Kept in sync with .claude/skills/ by the smoke tests.
SELF_SKILLS="manage-skills manage-skills-drift-triage"
CONFIG_DIR="${MANAGE_SKILLS_HOME:-$HOME/.manage-skills}"
# Where `github:owner/repo` resolves. Overridable so the tests can stand up a
# file:// tree and exercise cloning without a network.
GITHUB_BASE="${MANAGE_SKILLS_GITHUB_BASE:-https://github.com}"
SOURCES_FILE="$CONFIG_DIR/sources"
TARGETS_FILE="$CONFIG_DIR/targets"
# A remote source is kept twice on purpose. CACHE_DIR holds the git clone and
# is pure transport; SOURCES_DIR holds the files projects hardlink against.
# `update` copies content from one to the other with `cat >`, which writes in
# place and keeps the inode, so an update reaches every linked project at once.
# A plain `git pull` into the linked copy would rename-and-replace and strand
# every hardlink on the old content.
CACHE_DIR="$CONFIG_DIR/cache"
SOURCES_DIR="$CONFIG_DIR/sources.d"

# Colors (disabled if not a terminal)
if [[ -t 1 ]]; then
  BOLD=$'\033[1m' DIM=$'\033[2m' GREEN=$'\033[32m' YELLOW=$'\033[33m'
  CYAN=$'\033[36m' RED=$'\033[31m' RESET=$'\033[0m'
else
  BOLD='' DIM='' GREEN='' YELLOW='' CYAN='' RED='' RESET=''
fi

die() { echo "${RED}error:${RESET} $*" >&2; exit 1; }
info() { echo "${CYAN}$*${RESET}"; }
warn() { echo "${YELLOW}$*${RESET}"; }
# The tilde comes from a variable: bash 3.2 keeps the backslash in
# "${1//$HOME/\~}" and emits \~/... , which never expands back.
shorten() { local tilde='~'; echo "${1//$HOME/$tilde}"; }

# ── Config ──────────────────────────────────────────────────────────

ensure_config() {
  [[ -d "$CONFIG_DIR" && -f "$TARGETS_FILE" && -f "$SOURCES_FILE" ]] && return
  if [[ ! -d "$CONFIG_DIR" ]]; then
    mkdir -p "$CONFIG_DIR"
    info "Created $CONFIG_DIR"
  fi
  # Write default targets
  if [[ ! -f "$TARGETS_FILE" ]]; then
    cat > "$TARGETS_FILE" <<'TARGETS'
claude:.claude/skills:SKILL.md
codex:.agents/skills:SKILL.md
TARGETS
    info "Default targets: claude (.claude/skills), codex (.agents/skills)"
  fi
  [[ -f "$SOURCES_FILE" ]] && return
  # Empty sources file with comment
  cat > "$SOURCES_FILE" << 'SOURCES'
# manage-skills source directories
# One directory per line. These are scanned for skill files.
# Order is priority: when two sources provide the same skill name, the first wins.
# Lines starting with # are ignored. ~ is expanded.
# A trailing "# label" describes the source and shows up in 'locations'.
#
# Example:
# ~/dev/shared-skills        # Cross-language: K8s, CI, tools
# ~/dev/perl/shared-skills   # Shared Perl ecosystem
SOURCES
  warn "No sources configured yet. Run: manage-skills sources add ~/dev/shared-skills"
}

expand_path() {
  local p="$1"
  p="${p/#\~/$HOME}"
  echo "$p"
}

trim() {
  local v="$1"
  v="${v#"${v%%[![:space:]]*}"}"
  echo "${v%"${v##*[![:space:]]}"}"
}

# Splits a source line into SOURCE_PATH and SOURCE_LABEL. A source line may
# carry a trailing "# label" saying what lives there:
#   ~/dev/shared-skills   # Cross-language: K8s, CI, tools
SOURCE_PATH=""
SOURCE_LABEL=""
parse_source_line() {
  local line="$1"
  SOURCE_LABEL=""
  [[ "$line" == *"#"* ]] && SOURCE_LABEL=$(trim "${line#*#}")
  SOURCE_PATH=$(trim "${line%%#*}")
}

# Emits "expanded_path<TAB>label<TAB>spec" per configured source, existing ones
# only. `spec` is empty for a plain directory and carries the repository spec
# for a remote source, whose path resolves to its linked copy.
read_source_lines() {
  [[ -f "$SOURCES_FILE" ]] || return
  local line expanded spec
  while IFS= read -r line; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    parse_source_line "$line"
    [[ -z "$SOURCE_PATH" ]] && continue
    if is_remote_spec "$SOURCE_PATH"; then
      spec="$SOURCE_PATH"
      expanded="$SOURCES_DIR/$(remote_name "$SOURCE_PATH")"
    else
      spec=""
      expanded=$(expand_path "$SOURCE_PATH")
    fi
    [[ -d "$expanded" ]] && printf '%s\t%s\t%s\n' "$expanded" "$SOURCE_LABEL" "$spec"
  done < "$SOURCES_FILE"
}

# True when a source line already names exactly this path or spec. A substring
# test did until `Getty` started expanding to `github:Getty/skills`, at which
# point every prefix of a configured line read as already present.
source_configured() {
  local wanted line
  wanted="$1"
  [[ -f "$SOURCES_FILE" ]] || return 1
  while IFS= read -r line; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    parse_source_line "$line"
    [[ "$SOURCE_PATH" == "$wanted" ]] && return 0
  done < "$SOURCES_FILE"
  return 1
}

read_sources() {
  local path label spec
  while IFS=$'\t' read -r path label spec; do
    echo "$path"
  done < <(read_source_lines)
}

# All skills a source directory provides, in glob order, without dedup.
list_source_skills() {
  local source_dir="$1" target_file="${2:-SKILL.md}"
  local dirs skill_dir
  # Same detection as discovery: a source may group its skills one level deep.
  # Guarded assignment — a source with no skills exits 1 under set -e.
  dirs=$(skill_dirs_in "$source_dir" "$target_file") || return 0
  while IFS= read -r skill_dir; do
    [[ -n "$skill_dir" ]] || continue
    echo "${skill_dir##*/}"
  done <<EOF
$dirs
EOF
}

read_targets() {
  [[ -f "$TARGETS_FILE" ]] || return
  while IFS=: read -r name path file; do
    [[ -z "$name" || "$name" =~ ^[[:space:]]*# ]] && continue
    echo "$name:$path:$file"
  done < "$TARGETS_FILE"
}

# Resolves the target for commands that take no skill arguments. Accepts both
# `<command> <target>` and `<command> --target <name>`; the help text advertises
# the flag globally, so every command honours it.
resolve_target_arg() {
  local t="claude"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target|-t)
        [[ -n "${2:-}" ]] || die "Missing value for $1"
        t="$2"; shift 2 ;;
      -*)          shift ;;
      *)           t="$1"; shift ;;
    esac
  done
  echo "$t"
}

get_target() {
  local want="${1:-claude}"
  while IFS=: read -r name path file; do
    [[ "$name" == "$want" ]] && echo "$path:$file" && return
  done < <(read_targets)
  die "Unknown target '$want'. Check $TARGETS_FILE"
}

# ── Remote Sources ───────────────────────────────────────────────────

# A source line is remote when it names a repository rather than a directory.
is_remote_spec() {
  case "$1" in
    github:*|git@*|ssh://*|git://*|https://*|http://*|file://*) return 0 ;;
    *) return 1 ;;
  esac
}

# Clone URL for a spec. `github:owner/repo` is shorthand; anything else is
# already a URL that git understands. The host is a variable so the test suite
# can point the whole path at a local file:// tree and exercise it offline.
remote_clone_url() {
  case "$1" in
    github:*) echo "$GITHUB_BASE/${1#github:}.git" ;;
    *)        echo "$1" ;;
  esac
}

# Local name for a remote source — the repository name, minus any .git suffix.
#
# `skills` is the exception, and it is the convention this tool sets, so it is
# also the name most likely to collide: every owner has one. Those keep the
# owner in front — github:Getty/skills becomes getty-skills — because two
# sources sharing a directory under sources.d/ would overwrite each other.
remote_name() {
  local spec path name owner
  spec="$1"
  path="${spec%.git}"
  path="${path#github:}"
  name="${path##*/}"
  if [[ "$name" == "skills" && "$path" == */* ]]; then
    owner="${path%/*}"
    owner="${owner##*/}"
    owner="${owner##*:}"
    if [[ -n "$owner" ]]; then
      # bash 3.2 has no ${var,,}; a here-string keeps this out of a pipeline,
      # which `set -o pipefail` would make load-bearing inside an assignment.
      owner=$(tr '[:upper:]' '[:lower:]' <<<"$owner")
      echo "$owner-skills"
      return
    fi
  fi
  name="${name##*:}"
  echo "$name"
}

# `Getty` and `github:Getty` both name github.com/Getty/skills.
#
# That is a convention this tool sets rather than one it discovers: an owner
# name alone means the repository called `skills` under it. Exactly one name is
# tried, never a chain of guesses — a shorthand that quietly resolves somewhere
# else is worse than one that fails and says what to type instead.
#
# Returns 1 for anything that already names a repository, a path or a URL.
owner_source_spec() {
  local candidate="$1"
  case "$candidate" in
    github:*) candidate="${candidate#github:}" ;;
  esac
  # GitHub owner names are alphanumeric plus hyphens, never leading. That also
  # rules out ./foo, foo/bar, example.com and every URL scheme in one test.
  case "$candidate" in
    '' | -* | *[!A-Za-z0-9-]*) return 1 ;;
  esac
  echo "github:$candidate/skills"
}

# Every skill directory inside a checkout, one per line. Detected rather than
# configured: repos put their skills in skills/, in .claude/skills/, or at the
# root, and asking the user to know which is asking them to look it up.
#
# A set of any size usually groups its skills one directory deeper —
# skills/engineering/tdd, perl/perl-core — so when a candidate holds no skills
# directly, its subdirectories are searched once more. Not deeper than that: a
# SKILL.md further down is far more likely an example or a test fixture than a
# skill anyone meant to publish.
#
# The groups are organisation in the source repo and nothing more. Projects link
# skills by name, and sources.d/<name>/ is flat, so the grouping ends here.
skill_dirs_in() {
  local root="$1"
  local target_file="${2:-SKILL.md}"
  local candidate dir entry group found

  for candidate in "skills" ".claude/skills" "."; do
    # "$root/." would leak a /./ into every path derived from it, and those
    # paths end up verbatim in a plugin manifest.
    if [[ "$candidate" == "." ]]; then
      dir="$root"
    else
      dir="$root/$candidate"
    fi
    [[ -d "$dir" ]] || continue

    found=""
    for entry in "$dir"/*/; do
      [[ -f "$entry$target_file" ]] || continue
      # A symlinked skill directory is a pointer, not a source. A repo that
      # dogfoods its own library links its skills into .claude/skills; those
      # links must not shadow the library they point at (see skill-library repos).
      [[ -L "${entry%/}" ]] && continue
      echo "${entry%/}"
      found=yes
    done
    [[ -n "$found" ]] && return 0

    for group in "$dir"/*/; do
      [[ -d "$group" ]] || continue
      for entry in "$group"*/; do
        [[ -f "$entry$target_file" ]] || continue
        [[ -L "${entry%/}" ]] && continue
        echo "${entry%/}"
        found=yes
      done
    done
    [[ -n "$found" ]] && return 0
  done

  return 1
}

# Two groups offering the same skill name would collide the moment the set is
# flattened — the second copy overwrites the first, and nothing says so. Report
# it instead, the way a vanished upstream file is reported rather than deleted.
assert_unique_skill_names() {
  local dirs="$1" context="$2"
  local seen="" dupes="" name d

  while IFS= read -r d; do
    [[ -n "$d" ]] || continue
    name=$(basename "$d")
    case " $seen " in
      *" $name "*)
        case " $dupes " in
          *" $name "*) ;;
          *) dupes="$dupes $name" ;;
        esac
        ;;
      *) seen="$seen $name" ;;
    esac
  done <<EOF
$dirs
EOF

  [[ -z "$dupes" ]] && return 0

  local msg="$context: two groups provide the same skill name:$dupes"
  while IFS= read -r d; do
    [[ -n "$d" ]] || continue
    case " $dupes " in
      *" $(basename "$d") "*) msg="$msg
  $d" ;;
    esac
  done <<EOF
$dirs
EOF
  die "$msg

Skill names are flat once linked, so a project cannot hold both. Rename one in
the source repo."
}

require_git() {
  command -v git >/dev/null 2>&1 || die "git is required for remote sources"
}

# Mirrors the cache checkout into the linked copy without breaking inodes:
# existing files are overwritten in place, new ones copied, and files that
# vanished upstream are reported rather than deleted.
remote_materialise() {
  local name="$1" target_file="${2:-SKILL.md}"
  local cache="$CACHE_DIR/$name" live="$SOURCES_DIR/$name"
  local skill_dirs
  skill_dirs=$(skill_dirs_in "$cache" "$target_file") \
    || die "$name: no skills found in the checkout"
  assert_unique_skill_names "$skill_dirs" "$name"

  mkdir -p "$live"
  local added=0 updated=0 skill_dir skill_name present=""
  # A here-doc, not a pipe: a piped `while read` runs in a subshell and the
  # counters below would never make it back out.
  while IFS= read -r skill_dir; do
    [[ -n "$skill_dir" ]] || continue
    skill_name=$(basename "$skill_dir")
    present="$present $skill_name"
    mkdir -p "$live/$skill_name"
    local was_new=false changed=false rel
    if [[ ! -f "$live/$skill_name/$target_file" ]]; then
      cp "$skill_dir/$target_file" "$live/$skill_name/$target_file"
      was_new=true
    elif ! cmp -s "$skill_dir/$target_file" "$live/$skill_name/$target_file"; then
      # `cat >` truncates in place — every hardlink to this file follows.
      cat "$skill_dir/$target_file" > "$live/$skill_name/$target_file"
      changed=true
    fi

    # Companions travel with the skill, through the same truncating write, so a
    # project hardlinked to a reference file follows the update in place. A
    # companion that vanished upstream is left behind rather than deleted, for
    # the same reason a vanished skill is.
    while IFS= read -r rel; do
      [[ -n "$rel" ]] || continue
      mkdir -p "$(dirname "$live/$skill_name/$rel")"
      if [[ ! -f "$live/$skill_name/$rel" ]]; then
        cp "$skill_dir/$rel" "$live/$skill_name/$rel"
        changed=true
      elif ! cmp -s "$skill_dir/$rel" "$live/$skill_name/$rel"; then
        cat "$skill_dir/$rel" > "$live/$skill_name/$rel"
        changed=true
      fi
    done < <(skill_companion_files "$skill_dir" "$target_file")

    # Counted per skill, not per file: the caller prints these as skill counts.
    if $was_new; then
      added=$((added + 1))
    elif $changed; then
      updated=$((updated + 1))
    fi
  done <<EOF
$skill_dirs
EOF

  local gone=""
  for skill_dir in "$live"/*/; do
    [[ -d "$skill_dir" ]] || continue
    skill_name=$(basename "$skill_dir")
    case " $present " in
      *" $skill_name "*) continue ;;
    esac
    gone="$gone $skill_name"
  done

  echo "$added $updated"
  [[ -n "$gone" ]] && warn "  no longer upstream (kept, remove by hand):$gone"
  return 0
}

# Commits the local checkout is behind its remote. Purely local — no network,
# so `list` can show it without stalling.
remote_behind() {
  # Split, not `local name=$1 cache=$CACHE_DIR/$name`: bash declares every name
  # in a `local` first and assigns after, so the second would read an unset
  # variable and die under `set -u`.
  local name="$1"
  local cache="$CACHE_DIR/$name"
  [[ -d "$cache/.git" ]] || return 1
  local upstream
  upstream=$(git -C "$cache" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null) || return 1
  git -C "$cache" rev-list --count "HEAD..$upstream" 2>/dev/null || return 1
}

# ── Skill Discovery ─────────────────────────────────────────────────

# Find all skills across all sources. Output: source_dir:skill_name
# Deduplicates by skill name — first source wins (so order in sources file matters).
#
# Goes through skill_dirs_in, so a local source may group its skills one level
# deep just like a checkout may. The emitted source_dir is the skill's direct
# parent — for a grouped source that is the group directory — so every caller's
# $source_dir/$skill_name still resolves to the real path.
discover_skills() {
  local target_file="${1:-SKILL.md}"
  local seen="" source_dir skill_dir skill_name dirs
  while IFS= read -r source_dir; do
    # Guarded assignment: a source with no skills exits 1, and set -e would
    # otherwise kill the whole discovery.
    dirs=$(skill_dirs_in "$source_dir" "$target_file") || continue
    # Here-doc, not a pipe — a piped `while read` runs in a subshell and
    # `seen` would reset for every source.
    while IFS= read -r skill_dir; do
      [[ -n "$skill_dir" ]] || continue
      skill_name="${skill_dir##*/}"
      case ",$seen," in *,"$skill_name",*) continue ;; esac
      seen="$seen,$skill_name"
      echo "${skill_dir%/*}:$skill_name"
    done <<EOF
$dirs
EOF
  done < <(read_sources)
}

# Check if a skill file in the project is a hardlink to the source
is_hardlinked() {
  local project_file="$1"
  local source_file="$2"
  [[ -f "$project_file" ]] || return 1
  [[ -f "$source_file" ]] || return 1
  local inode_p inode_s
  inode_p=$(stat -c %i "$project_file" 2>/dev/null || stat -f %i "$project_file" 2>/dev/null)
  inode_s=$(stat -c %i "$source_file" 2>/dev/null || stat -f %i "$source_file" 2>/dev/null)
  [[ "$inode_p" == "$inode_s" ]]
}

# ── Companion files ──────────────────────────────────────────────────
#
# A skill is a directory, not a file: SKILL.md plus whatever it links to —
# references/, templates/, scripts/. Only SKILL.md identifies the skill, which
# is why discovery keys on it, but a relative link inside a SKILL.md is dead in
# a project that received that one file alone. So everything under the source
# skill directory is linked, not just the entry point.
#
# Emits paths relative to the skill directory, one per line, with the entry
# file left out — its own link is the caller's business.
skill_companion_files() {
  local skill_dir="$1"
  local target_file="$2"
  local f rel
  [[ -d "$skill_dir" ]] || return 0
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    rel="${f#$skill_dir/}"
    if [[ "$rel" != "$target_file" ]]; then
      echo "$rel"
    fi
  done < <(find "$skill_dir" -type f 2>/dev/null | LC_ALL=C sort)
}

# Hardlinks a skill's companion files into the project, creating subdirectories
# as it goes. Reports through two globals rather than stdout, because callers
# print their own lines: companions_linked and companions_diverged.
#
# $4 force: when false, a companion whose content differs from its source is
# left alone and counted as diverged — the same rule cmd_sync applies to
# SKILL.md, and for the same reason. A file that vanished upstream is never
# deleted here; a project may still be using it.
link_companion_files() {
  local source_skill_dir="$1"
  local dest_skill_dir="$2"
  local target_file="$3"
  local force="${4:-false}"
  local rel src dst
  companions_linked=0
  companions_diverged=0
  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    src="$source_skill_dir/$rel"
    dst="$dest_skill_dir/$rel"
    if is_hardlinked "$dst" "$src" 2>/dev/null; then
      continue
    fi
    if [[ -f "$dst" ]] && ! $force && ! cmp -s "$dst" "$src"; then
      companions_diverged=$((companions_diverged + 1))
      continue
    fi
    mkdir -p "$(dirname "$dst")"
    rm -f "$dst"
    ln "$src" "$dst"
    companions_linked=$((companions_linked + 1))
  done < <(skill_companion_files "$source_skill_dir" "$target_file")
}

# Counts a skill's companion files that are not hardlinks to their source,
# missing ones included. Reports through companions_unlinked.
check_companion_files() {
  local source_skill_dir="$1"
  local dest_skill_dir="$2"
  local target_file="$3"
  local rel
  companions_unlinked=0
  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    if ! is_hardlinked "$dest_skill_dir/$rel" "$source_skill_dir/$rel" 2>/dev/null; then
      companions_unlinked=$((companions_unlinked + 1))
    fi
  done < <(skill_companion_files "$source_skill_dir" "$target_file")
}

# ── Layout ───────────────────────────────────────────────────────────

term_width() {
  # No `[[ -t 1 ]]` guard: this runs inside $(...), where stdout is a pipe.
  # tput falls back to the terminfo default when there is no terminal.
  local w=""
  w=$(tput cols 2>/dev/null || true)
  [[ -n "$w" ]] || w="${COLUMNS:-}"
  case "$w" in
    ''|*[!0-9]*) w=80 ;;
  esac
  [[ "$w" -lt 24 ]] && w=80
  echo "$w"
}

# Reads "<visible_width>\t<rendered_text>" lines from stdin and prints them as
# a multi-column grid, filling column-major like `ls`. The visible width is
# passed in rather than measured: the rendered text carries ANSI escapes and a
# multibyte ● marker, both of which ${#var} counts wrong.
print_grid() {
  local term_w="$1" gutter="${2:-2}"
  local cell_w=() cell_txt=()
  local lw lt
  while IFS=$'\t' read -r lw lt; do
    cell_w[${#cell_w[@]}]="$lw"
    cell_txt[${#cell_txt[@]}]="$lt"
  done
  local n=${#cell_w[@]}
  [[ "$n" -eq 0 ]] && return

  local maxw=0 i
  for ((i = 0; i < n; i++)); do
    [[ "${cell_w[$i]}" -gt "$maxw" ]] && maxw=${cell_w[$i]}
  done

  local colw=$((maxw + gutter))
  local cols=$(( (term_w - 2) / colw ))
  [[ "$cols" -lt 1 ]] && cols=1
  [[ "$cols" -gt "$n" ]] && cols=$n
  local rows=$(( (n + cols - 1) / cols ))

  local row col idx
  for ((row = 0; row < rows; row++)); do
    printf "  "
    for ((col = 0; col < cols; col++)); do
      idx=$((col * rows + row))
      [[ "$idx" -ge "$n" ]] && continue
      printf "%s" "${cell_txt[$idx]}"
      # no trailing padding on the last cell of a row
      [[ $((idx + rows)) -lt "$n" ]] && printf "%*s" "$((colw - ${cell_w[$idx]}))" ""
    done
    printf "\n"
  done
}

# Sets MARKER and MARKER_COLOR for a skill's link state.
# Globals instead of a subshell: this runs once per skill.
MARKER=""
MARKER_COLOR=""
skill_marker() {
  local project_file="$1" source_file="$2"
  if [[ -f "$project_file" ]]; then
    if is_hardlinked "$project_file" "$source_file" 2>/dev/null; then
      MARKER="[*]"; MARKER_COLOR="$GREEN"
    else
      MARKER="[~]"; MARKER_COLOR="$YELLOW"
    fi
  else
    MARKER="[ ]"; MARKER_COLOR="$DIM"
  fi
}

# ── Commands ─────────────────────────────────────────────────────────

cmd_init() {
  ensure_config
  if [[ -f "$SOURCES_FILE" ]] && grep -qv '^#' "$SOURCES_FILE" 2>/dev/null; then
    info "Config already exists at $CONFIG_DIR"
  fi
  echo ""
  info "Next steps:"
  echo "  manage-skills sources add ~/dev/shared-skills"
  echo "  manage-skills sources add ~/dev/perl/shared-skills"
  echo "  cd ~/your-project && manage-skills"
}

cmd_sources() {
  local subcmd="${1:-list}"
  shift 2>/dev/null || true

  case "$subcmd" in
    list)
      if [[ ! -f "$SOURCES_FILE" ]]; then
        warn "No sources configured. Run: manage-skills init"
        return
      fi
      echo "${BOLD}Skill sources:${RESET} ${DIM}(first match wins)${RESET}"
      while IFS= read -r line; do
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
        parse_source_line "$line"
        [[ -z "$SOURCE_PATH" ]] && continue
        local expanded note=""
        [[ -n "$SOURCE_LABEL" ]] && note=" — $SOURCE_LABEL"
        local kind=""
        if is_remote_spec "$SOURCE_PATH"; then
          expanded="$SOURCES_DIR/$(remote_name "$SOURCE_PATH")"
          local behind
          behind=$(remote_behind "$(remote_name "$SOURCE_PATH")" || true)
          if [[ -n "$behind" && "$behind" != "0" ]]; then
            kind=", $behind update(s)"
          else
            kind=", remote"
          fi
        else
          expanded=$(expand_path "$SOURCE_PATH")
        fi
        if [[ -d "$expanded" ]]; then
          local count
          count=$(list_source_skills "$expanded" | wc -l | tr -d ' ')
          echo "  ${GREEN}●${RESET} $SOURCE_PATH  ${DIM}($count skills$kind)$note${RESET}"
        else
          echo "  ${RED}●${RESET} $SOURCE_PATH  ${DIM}(not fetched — run: manage-skills update)$note${RESET}"
        fi
      done < "$SOURCES_FILE"
      ;;
    add)
      [[ -z "${1:-}" ]] && die "Usage: manage-skills sources add <directory|repo|owner> [label...]"
      local dir="$1"
      shift
      local label="$*"
      local expanded shorthand
      expanded=""
      shorthand=""

      # A bare owner name means that owner's `skills` repo — but only when
      # nothing of that name is on disk. What is actually there is never
      # guessed past, so the directory wins and the shorthand is offered.
      is_remote_spec "$dir" || expanded=$(expand_path "$dir")
      shorthand=$(owner_source_spec "$dir" 2>/dev/null || true)
      if [[ -n "$shorthand" && ( -z "$expanded" || ! -d "$expanded" ) ]]; then
        echo "  ${DIM}$dir → $shorthand${RESET}"
        dir="$shorthand"
        expanded=""
        shorthand=""
      fi

      if is_remote_spec "$dir"; then
        if source_configured "$dir"; then
          warn "Already in sources: $dir"
          return
        fi
        remote_add "$dir"
        if [[ -n "$label" ]]; then
          printf '%s   # %s\n' "$dir" "$label" >> "$SOURCES_FILE"
          info "Added: $dir — $label"
        else
          echo "$dir" >> "$SOURCES_FILE"
          info "Added: $dir"
        fi
        return
      fi
      expanded=$(expand_path "$dir")
      [[ -d "$expanded" ]] || die "Directory not found: $expanded"
      if source_configured "$dir"; then
        warn "Already in sources: $dir"
        return
      fi
      if [[ -n "$label" ]]; then
        printf '%s   # %s\n' "$dir" "$label" >> "$SOURCES_FILE"
        info "Added: $dir — $label"
      else
        echo "$dir" >> "$SOURCES_FILE"
        info "Added: $dir"
      fi
      if [[ -n "$shorthand" ]]; then
        echo "  ${DIM}a directory of that name is here, so it won${RESET}"
        echo "  ${DIM}for the GitHub owner: manage-skills sources add github:$dir${RESET}"
      fi
      ;;
    remove)
      [[ -z "${1:-}" ]] && die "Usage: manage-skills sources remove <directory>"
      local dir="$1"
      local tmp
      tmp=$(mktemp)
      grep -vF "$dir" "$SOURCES_FILE" > "$tmp" || true
      mv "$tmp" "$SOURCES_FILE"
      info "Removed: $dir"
      if is_remote_spec "$dir"; then
        local name
        name=$(remote_name "$dir")
        # Left on disk on purpose: projects may still hold hardlinks into it,
        # and deleting the file they point at is not this command's call.
        echo "  ${DIM}checkout kept at $(shorten "$CACHE_DIR/$name")${RESET}"
        echo "  ${DIM}linked copy kept at $(shorten "$SOURCES_DIR/$name")${RESET}"
      fi
      ;;
    *)
      die "Unknown sources command: $subcmd (use list, add, remove)"
      ;;
  esac
}

cmd_targets() {
  local subcmd="${1:-list}"
  shift 2>/dev/null || true

  case "$subcmd" in
    list)
      echo "${BOLD}Configured targets:${RESET}"
      while IFS=: read -r name path file; do
        [[ -z "$name" || "$name" =~ ^[[:space:]]*# ]] && continue
        echo "  ${GREEN}$name${RESET}  →  $path/$file"
      done < <(read_targets)
      ;;
    add)
      [[ -z "${1:-}" || -z "${2:-}" || -z "${3:-}" ]] && die "Usage: manage-skills targets add <name> <path> <file>"
      echo "$1:$2:$3" >> "$TARGETS_FILE"
      info "Added target: $1 → $2/$3"
      ;;
    *)
      die "Unknown targets command: $subcmd (use list, add)"
      ;;
  esac
}

cmd_list() {
  local target_name
  target_name=$(resolve_target_arg "$@")
  local target_info
  target_info=$(get_target "$target_name")
  local target_path="${target_info%%:*}"
  local target_file="${target_info##*:}"
  local project_skills_dir="$PWD/$target_path"

  # Grid only on a terminal — piped output stays one skill per line so it
  # keeps working with grep/awk.
  local grid=false
  [[ -t 1 ]] && grid=true
  local width
  width=$(term_width)

  echo "${BOLD}Available skills${RESET} ${DIM}(target: $target_name)${RESET}"
  $grid || echo ""

  local has_skills=false seen="" group="" buf=""

  while IFS=: read -r source_dir skill_name; do
    has_skills=true
    seen="$seen,$skill_name"
    skill_marker "$project_skills_dir/$skill_name/$target_file" \
                 "$source_dir/$skill_name/$target_file"

    if $grid; then
      if [[ "$source_dir" != "$group" ]]; then
        [[ -n "$buf" ]] && printf '%s' "$buf" | print_grid "$width"
        buf=""
        group="$source_dir"
        echo ""
        echo "${BOLD}$(shorten "$source_dir")${RESET}"
      fi
      buf="$buf$((4 + ${#skill_name}))	$MARKER_COLOR$MARKER$RESET $skill_name"$'\n'
    else
      case "$MARKER" in
        '[~]') echo "  ${MARKER_COLOR}${MARKER}${RESET} $skill_name  ${DIM}(local copy, not linked)${RESET}" ;;
        *)     echo "  ${MARKER_COLOR}${MARKER}${RESET} $skill_name  ${DIM}← $(shorten "$source_dir")${RESET}" ;;
      esac
    fi
  done < <(discover_skills "$target_file")

  [[ -n "$buf" ]] && printf '%s' "$buf" | print_grid "$width"
  buf=""

  # Originals: skills the project owns, with no source providing that name.
  if [[ -d "$project_skills_dir" ]]; then
    local first_original=true
    for skill_dir in "$project_skills_dir"/*/; do
      [[ -f "$skill_dir/$target_file" ]] || continue
      local skill_name
      skill_name=$(basename "$skill_dir")
      case ",$seen," in *,"$skill_name",*) continue ;; esac
      if $grid; then
        if $first_original; then
          first_original=false
          echo ""
          echo "${BOLD}This project${RESET} ${DIM}(source of truth)${RESET}"
        fi
        buf="$buf$((4 + ${#skill_name}))	 ${CYAN}●${RESET} $skill_name"$'\n'
      else
        echo "   ●  $skill_name  ${DIM}(original)${RESET}"
      fi
    done
    [[ -n "$buf" ]] && printf '%s' "$buf" | print_grid "$width"
  fi

  if ! $has_skills; then
    warn "No skills found in any source. Run: manage-skills sources add <dir>"
  fi

  echo ""
  echo "${DIM}Legend: [*] hardlinked  [~] local copy  [ ] available  ● original${RESET}"
}

cmd_locations() {
  local target_name
  target_name=$(resolve_target_arg "$@")
  local target_info
  target_info=$(get_target "$target_name")
  local target_path="${target_info%%:*}"
  local target_file="${target_info##*:}"
  local project_skills_dir="$PWD/$target_path"

  local grid=false
  [[ -t 1 ]] && grid=true
  local width
  width=$(term_width)

  echo "${BOLD}Skill locations${RESET} ${DIM}(target: $target_name)${RESET}"

  local seen="" shadowed=0 any=false
  local source_dir label buf name skill_dir

  local spec behind heading
  while IFS=$'\t' read -r source_dir label spec; do
    any=true
    echo ""
    heading="$(shorten "$source_dir")"
    [[ -n "$spec" ]] && heading="$spec"
    if [[ -n "$label" ]]; then
      heading="$heading  ${DIM}— $label${RESET}"
    fi
    if [[ -n "$spec" ]]; then
      behind=$(remote_behind "$(remote_name "$spec")" || true)
      [[ -n "$behind" && "$behind" != "0" ]] &&
        heading="$heading  ${YELLOW}($behind update(s) — run: manage-skills update)${RESET}"
    fi
    echo "${BOLD}$heading${RESET}"

    buf=""
    while IFS= read -r name; do
      case ",$seen," in
        *,"$name",*)
          # An earlier source already provides this name, so this copy never
          # wins a link or a sync — the silent shadowing case.
          shadowed=$((shadowed + 1))
          buf="$buf$((${#name} + 1))"$'\t'"${DIM}$name*${RESET}"$'\n'
          ;;
        *)
          seen="$seen,$name"
          buf="$buf${#name}"$'\t'"$name"$'\n'
          ;;
      esac
    done < <(list_source_skills "$source_dir" "$target_file")

    if [[ -z "$buf" ]]; then
      echo "  ${DIM}(no skills)${RESET}"
    elif $grid; then
      printf '%s' "$buf" | print_grid "$width"
    else
      printf '%s' "$buf" | cut -f2- | sed 's/^/  /'
    fi
  done < <(read_source_lines)

  if ! $any; then
    echo ""
    warn "No sources configured. Run: manage-skills sources add <dir> [label]"
  fi

  # Skills this project owns outright — no source provides that name.
  if [[ -d "$project_skills_dir" ]]; then
    buf=""
    for skill_dir in "$project_skills_dir"/*/; do
      [[ -f "$skill_dir/$target_file" ]] || continue
      name=$(basename "$skill_dir")
      case ",$seen," in *,"$name",*) continue ;; esac
      buf="$buf${#name}"$'\t'"${CYAN}$name${RESET}"$'\n'
    done
    if [[ -n "$buf" ]]; then
      echo ""
      echo "${BOLD}Owned by $(basename "$PWD")${RESET} ${DIM}(source of truth — no source provides these)${RESET}"
      if $grid; then
        printf '%s' "$buf" | print_grid "$width"
      else
        printf '%s' "$buf" | cut -f2- | sed 's/^/  /'
      fi
    fi
  fi

  if [[ $shadowed -gt 0 ]]; then
    echo ""
    echo "${DIM}* shadowed — an earlier source already provides that name, so this${RESET}"
    echo "${DIM}  copy never wins a link or a sync. Reorder $SOURCES_FILE to change it.${RESET}"
  fi

  # Hand-written context that cannot be derived: naming conventions, which
  # skills pair up, which ones are conditional.
  local notes_file="$CONFIG_DIR/notes.md"
  echo ""
  if [[ -f "$notes_file" ]]; then
    echo "${BOLD}Notes${RESET} ${DIM}$(shorten "$notes_file")${RESET}"
    sed 's/^/  /' "$notes_file"
  else
    echo "${DIM}Conventions and other hand-written context: create $(shorten "$notes_file")${RESET}"
  fi
}

# ── Update ───────────────────────────────────────────────────────────

remote_add() {
  local spec="$1"
  require_git
  local name url cache
  name=$(remote_name "$spec")
  url=$(remote_clone_url "$spec")
  cache="$CACHE_DIR/$name"

  if [[ -d "$cache/.git" ]]; then
    info "Already cloned: $(shorten "$cache")"
  else
    [[ -e "$cache" ]] && die "$name: $(shorten "$cache") exists and is not a checkout"
    mkdir -p "$CACHE_DIR"
    info "Cloning $url"
    if ! git clone --quiet --depth 1 "$url" "$cache"; then
      rm -rf "$cache"
      # The one shorthand that resolves without being typed in full deserves
      # the one error message that says what to type instead.
      case "$spec" in
        github:*/skills)
          local owner="${spec#github:}"
          owner="${owner%/skills}"
          die "${GITHUB_BASE#https://}/$owner/skills not found.
  Give the repo in full:
    manage-skills sources add github:$owner/<repo>" ;;
      esac
      die "Clone failed: $url"
    fi
  fi

  local counts
  counts=$(remote_materialise "$name")
  echo "  ${GREEN}${counts%% *}${RESET} skills available in $(shorten "$SOURCES_DIR/$name")"
}

cmd_update() {
  local check_only=false
  local wanted=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --check|-n) check_only=true; shift ;;
      *) wanted[${#wanted[@]}]="$1"; shift ;;
    esac
  done

  local any=false found=false
  local source_dir label spec name behind

  while IFS=$'\t' read -r source_dir label spec; do
    [[ -n "$spec" ]] || continue
    any=true
    name=$(remote_name "$spec")
    if [[ ${#wanted[@]} -gt 0 ]]; then
      local match=false w
      for w in "${wanted[@]}"; do
        [[ "$w" == "$name" || "$w" == "$spec" ]] && match=true
      done
      $match || continue
    fi
    found=true

    require_git
    echo "${BOLD}$spec${RESET}"
    git -C "$CACHE_DIR/$name" fetch --quiet --depth 1 origin 2>/dev/null \
      || { warn "  fetch failed — offline?"; continue; }

    behind=$(remote_behind "$name" || echo "")
    if [[ -z "$behind" || "$behind" == "0" ]]; then
      echo "  ${GREEN}up to date${RESET}"
      continue
    fi

    if $check_only; then
      echo "  ${YELLOW}$behind commit(s) behind${RESET} — run: manage-skills update $name"
      continue
    fi

    local upstream
    upstream=$(git -C "$CACHE_DIR/$name" rev-parse --abbrev-ref '@{upstream}')
    git -C "$CACHE_DIR/$name" reset --quiet --hard "$upstream" || die "$name: reset failed"

    local counts added updated
    counts=$(remote_materialise "$name")
    added="${counts%% *}"; updated="${counts##* }"
    echo "  ${GREEN}$updated updated${RESET}, ${GREEN}$added new${RESET}"
    # The updated files were written in place, so every project hardlinked to
    # them already has the new content — nothing to sync anywhere.
  done < <(read_source_lines)

  if ! $any; then
    warn "No remote sources configured."
    echo "  manage-skills sources add github:owner/repo   ${DIM}(or just: owner)${RESET}"
    return
  fi
  if [[ ${#wanted[@]} -gt 0 ]] && ! $found; then
    die "No remote source matches: ${wanted[*]}"
  fi
}

# ── Package ──────────────────────────────────────────────────────────

# owner/repo from a git remote, whatever protocol it uses.
git_repo_slug() {
  local dir="$1" url
  url=$(git -C "$dir" remote get-url origin 2>/dev/null) || return 1
  url="${url%.git}"
  case "$url" in
    *:*/*) url="${url##*:}" ;;
  esac
  case "$url" in
    */*/*) url="${url#*//}"; url="${url#*/}" ;;
  esac
  echo "$url"
}

# Writes one plugin manifest. Returns 0 when it wrote, 1 when it left an
# existing file alone — an existing manifest is somebody's work.
write_plugin_manifest() {
  local path="$1" name="$2" slug="$3" skills_json="$4" force="$5"
  if [[ -f "$path" ]] && ! $force; then
    warn "Manifest exists, leaving it alone: $(shorten "$path")"
    echo "  ${DIM}re-run with --force to overwrite${RESET}"
    return 1
  fi
  mkdir -p "$(dirname "$path")"
  cat > "$path" <<MANIFEST
{
  "name": "$name",
  "description": "TODO: one line on what these skills cover — this is what people read when browsing.",
  "version": "0.1.0",
  "homepage": "https://github.com/$slug",
  "repository": "https://github.com/$slug",
  "skills": $skills_json
}
MANIFEST
  info "Wrote $(shorten "$path")"
  return 0
}

cmd_package() {
  local dir="${1:-$PWD}" force=false
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force|-f) force=true; shift ;;
      *) args[${#args[@]}]="$1"; shift ;;
    esac
  done
  [[ ${#args[@]} -gt 0 ]] && dir="${args[0]}"
  dir=$(expand_path "$dir")
  [[ -d "$dir" ]] || die "Directory not found: $dir"
  dir=$(cd -P "$dir" && pwd)

  local skill_dirs
  skill_dirs=$(skill_dirs_in "$dir") \
    || die "No skills found in $(shorten "$dir") — expected skill directories in ./, skills/ or .claude/skills/, or grouped one level inside those"
  assert_unique_skill_names "$skill_dirs" "$(shorten "$dir")"

  local names="" count=0 skill_dir skill_name parent parents=""
  while IFS= read -r skill_dir; do
    [[ -n "$skill_dir" ]] || continue
    skill_name=$(basename "$skill_dir")
    names="$names $skill_name"
    count=$((count + 1))
    parent=$(dirname "$skill_dir")
    case " $parents " in
      *" $parent "*) ;;
      *) parents="$parents $parent" ;;
    esac
  done <<EOF
$skill_dirs
EOF
  [[ $count -eq 0 ]] && die "No SKILL.md files under $(shorten "$dir")"

  # One directory holding every skill can be named as one path. Grouped sets
  # cannot, so the manifest lists each skill directory instead — the shape
  # mattpocock/skills uses, and the only one that survives grouping.
  local rel skills_json location group_count=0
  for parent in $parents; do group_count=$((group_count + 1)); done
  if [[ $group_count -eq 1 ]]; then
    rel="${parents# }"
    rel="${rel#$dir}"
    rel=".${rel:-/}"
    skills_json="\"$rel\""
    location="$rel"
  else
    local first=yes rel_one
    skills_json="["
    while IFS= read -r skill_dir; do
      [[ -n "$skill_dir" ]] || continue
      rel_one=".${skill_dir#$dir}"
      if [[ $first == yes ]]; then
        skills_json="$skills_json\"$rel_one\""
        first=no
      else
        skills_json="$skills_json, \"$rel_one\""
      fi
    done <<EOF
$skill_dirs
EOF
    skills_json="$skills_json]"
    location="$group_count groups"
  fi

  local plugin_name
  plugin_name=$(basename "$dir")
  local slug
  slug=$(git_repo_slug "$dir" || echo "OWNER/$plugin_name")

  echo "${BOLD}Packaging $(shorten "$dir")${RESET}"
  echo "  ${GREEN}$count skills${RESET} in $location:$names"
  echo ""

  # Claude Code and Codex both lay skills out as <name>/SKILL.md, so one
  # directory serves both. Only the manifests differ.
  local wrote=0
  write_plugin_manifest "$dir/.claude-plugin/plugin.json" "$plugin_name" "$slug" "$skills_json" "$force" \
    && wrote=$((wrote + 1))
  write_plugin_manifest "$dir/.codex-plugin/plugin.json" "$plugin_name" "$slug" "$skills_json" "$force" \
    && wrote=$((wrote + 1))
  [[ $wrote -gt 0 ]] && echo "  ${YELLOW}Fill in the description before publishing.${RESET}"

  echo ""
  echo "${BOLD}Claude Code${RESET} ${DIM}— add to your marketplace's .claude-plugin/marketplace.json${RESET}"
  cat <<ENTRY

    {
      "name": "$plugin_name",
      "source": { "source": "github", "repo": "$slug" },
      "description": "..."
    }
ENTRY
  echo ""
  echo "${BOLD}Codex${RESET} ${DIM}— add to your marketplace's .agents/plugins/marketplace.json${RESET}"
  cat <<ENTRY

    {
      "name": "$plugin_name",
      "source": { "source": "url", "url": "https://github.com/$slug" },
      "policy": { "installation": "AVAILABLE", "authentication": "NONE" },
      "category": "Productivity"
    }
ENTRY
  echo ""
  echo "${BOLD}Then people can take your skills three ways:${RESET}"
  echo "  ${DIM}Claude Code${RESET}   /plugin install $plugin_name@<marketplace>"
  echo "  ${DIM}Codex${RESET}         codex plugin add $plugin_name@<marketplace>"
  # A repo called `skills` is reachable by owner name alone — print the
  # shortest line that actually works for this repo, not the general form.
  case "$slug" in
    */skills) echo "  ${DIM}Any tool${RESET}      manage-skills sources add ${slug%/skills}" ;;
    *)        echo "  ${DIM}Any tool${RESET}      manage-skills sources add github:$slug" ;;
  esac
  echo ""
  echo "${DIM}Same repo, same files, no copy. Both plugin systems read"
  echo "<name>/SKILL.md, so only the two manifests differ.${RESET}"

  if command -v claude >/dev/null 2>&1; then
    echo ""
    claude plugin validate "$dir" 2>&1 | tail -3 || true
  fi
}

# ── Self ─────────────────────────────────────────────────────────────

# Absolute directory of the running script, following symlinks. install.sh
# symlinks the script into a bin dir in dev mode, so $0's own directory is the
# bin dir, not the checkout.
self_script_path() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  echo "$(cd -P "$(dirname "$src")" && pwd)/$(basename "$src")"
}

# clone | plugin | standalone — how this copy got here decides how it updates.
self_install_kind() {
  local dir
  dir=$(dirname "$(self_script_path)")
  case "$dir" in
    */plugins/cache/*) echo "plugin"; return ;;
  esac
  if git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "clone"
  else
    echo "standalone"
  fi
}

# Where this installation's own skills live, if anywhere.
self_skills_dir() {
  local dir
  dir=$(dirname "$(self_script_path)")
  [[ -d "$dir/skills" ]] && { echo "$dir/skills"; return; }
  [[ -d "$dir/.claude/skills" ]] && { echo "$dir/.claude/skills"; return; }
  [[ -d "$SOURCES_DIR/manage-skills" ]] && { echo "$SOURCES_DIR/manage-skills"; return; }
  return 1
}

cmd_self() {
  local subcmd="${1:-status}"
  shift 2>/dev/null || true

  local script_path kind skills_dir
  script_path=$(self_script_path)
  kind=$(self_install_kind)
  skills_dir=$(self_skills_dir || true)

  case "$subcmd" in
    status)
      echo "${BOLD}manage-skills${RESET} v$VERSION"
      echo "  script    $(shorten "$script_path")  ${DIM}($kind)${RESET}"
      echo "  config    $(shorten "$CONFIG_DIR")"
      if [[ -n "$skills_dir" ]]; then
        echo "  skills    $(shorten "$skills_dir")  ${DIM}($(list_source_skills "$skills_dir" | wc -l | tr -d ' ') shipped)${RESET}"
        if read_sources | grep -qxF "$skills_dir"; then
          echo "            ${GREEN}registered as a source${RESET}"
        else
          echo "            ${YELLOW}not registered${RESET} — run: manage-skills self install"
        fi
      else
        echo "  skills    ${YELLOW}not present${RESET} — run: manage-skills self install"
      fi
      ;;
    install)
      if [[ -z "$skills_dir" ]]; then
        # No checkout to read them from: clone the repo like any other remote
        # source, which also gives `self update` and `update` for free.
        info "Fetching shipped skills from $SELF_REPO"
        remote_add "github:$SELF_REPO"
        skills_dir="$SOURCES_DIR/$(remote_name "github:$SELF_REPO")"
      fi
      if read_sources | grep -qxF "$skills_dir"; then
        info "Already a source: $(shorten "$skills_dir")"
      else
        # Appended, so it stays lowest priority — your own skills win.
        # Absolute, not shortened: what a config stores and what a terminal
        # shows are different jobs.
        printf '%s   # %s\n' "$skills_dir" "Shipped with manage-skills" >> "$SOURCES_FILE"
        info "Registered as a source: $(shorten "$skills_dir")"
      fi
      echo ""
      echo "Link them into a project with:"
      echo "  manage-skills link $SELF_SKILLS"
      ;;
    update)
      case "$kind" in
        clone)
          local dir
          dir=$(dirname "$script_path")
          info "Installed from a checkout — update it with git:"
          echo "  git -C $(shorten "$dir") pull"
          ;;
        plugin)
          info "Installed as a Claude Code plugin — update it from Claude Code:"
          echo "  /plugin update manage-skills"
          ;;
        standalone)
          local tmp url
          tmp=$(mktemp)
          url="https://raw.githubusercontent.com/$SELF_REPO/main/manage-skills"
          info "Fetching $url"
          if command -v curl >/dev/null 2>&1; then
            curl -fsSL "$url" -o "$tmp" || { rm -f "$tmp"; die "Download failed"; }
          elif command -v wget >/dev/null 2>&1; then
            wget -qO "$tmp" "$url" || { rm -f "$tmp"; die "Download failed"; }
          else
            rm -f "$tmp"; die "Neither curl nor wget found"
          fi
          bash -n "$tmp" 2>/dev/null || { rm -f "$tmp"; die "Downloaded script failed the syntax check — not installing"; }
          local new_version
          new_version=$(grep -m1 '^VERSION=' "$tmp" | cut -d'"' -f2)
          if [[ "$new_version" == "$VERSION" ]]; then
            rm -f "$tmp"
            info "Already on the latest version ($VERSION)"
            return
          fi
          # exec so the running shell stops reading this file before it changes.
          echo "  ${GREEN}updating${RESET} $VERSION → $new_version"
          exec sh -c "cat '$tmp' > '$script_path' && chmod +x '$script_path' && rm -f '$tmp' && echo '  manage-skills is now $new_version'"
          ;;
      esac
      if [[ -n "$skills_dir" && "$skills_dir" == "$SOURCES_DIR/"* ]]; then
        echo ""
        info "Refreshing shipped skills"
        cmd_update "$(remote_name "github:$SELF_REPO")"
      fi
      ;;
    *)
      die "Unknown self command: $subcmd (use status, install, update)"
      ;;
  esac
}

cmd_link() {
  local target_name="claude"
  local skills=()

  # Parse args
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target|-t)
        [[ -n "${2:-}" ]] || die "Missing value for $1"
        target_name="$2"; shift 2 ;;
      *) skills+=("$1"); shift ;;
    esac
  done

  [[ ${#skills[@]} -eq 0 ]] && die "Usage: manage-skills link <skill> [skill...] [--target name]"

  local target_info
  target_info=$(get_target "$target_name")
  local target_path="${target_info%%:*}"
  local target_file="${target_info##*:}"
  local project_skills_dir="$PWD/$target_path"

  for skill_name in "${skills[@]}"; do
    local found=false
    while IFS=: read -r source_dir sname; do
      [[ "$sname" == "$skill_name" ]] || continue
      found=true
      local source_file="$source_dir/$skill_name/$target_file"
      local dest_dir="$project_skills_dir/$skill_name"
      local dest_file="$dest_dir/$target_file"

      if is_hardlinked "$dest_file" "$source_file" 2>/dev/null; then
        # The entry file is linked, but companions may still be missing —
        # a skill that grew a references/ after it was first linked.
        link_companion_files "$source_dir/$skill_name" "$dest_dir" "$target_file" true
        if [[ $companions_linked -gt 0 ]]; then
          echo "  ${GREEN}linked${RESET} $skill_name ${DIM}($companions_linked companion files)${RESET}"
        else
          info "$skill_name: already linked"
        fi
        break
      fi

      mkdir -p "$dest_dir"
      rm -f "$dest_file"
      ln "$source_file" "$dest_file"
      link_companion_files "$source_dir/$skill_name" "$dest_dir" "$target_file" true
      if [[ $companions_linked -gt 0 ]]; then
        echo "  ${GREEN}linked${RESET} $skill_name ← $source_dir ${DIM}(+$companions_linked files)${RESET}"
      else
        echo "  ${GREEN}linked${RESET} $skill_name ← $source_dir"
      fi
      break
    done < <(discover_skills "$target_file")

    if ! $found; then
      warn "$skill_name: not found in any source"
    fi
  done
}

cmd_unlink() {
  local target_name="claude"
  local skills=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target|-t)
        [[ -n "${2:-}" ]] || die "Missing value for $1"
        target_name="$2"; shift 2 ;;
      *) skills+=("$1"); shift ;;
    esac
  done

  [[ ${#skills[@]} -eq 0 ]] && die "Usage: manage-skills unlink <skill> [skill...] [--target name]"

  local target_info
  target_info=$(get_target "$target_name")
  local target_path="${target_info%%:*}"
  local target_file="${target_info##*:}"
  local project_skills_dir="$PWD/$target_path"

  for skill_name in "${skills[@]}"; do
    local dest_dir="$project_skills_dir/$skill_name"
    if [[ -d "$dest_dir" ]]; then
      rm -rf "$dest_dir"
      echo "  ${RED}unlinked${RESET} $skill_name"
    else
      warn "$skill_name: not found in project"
    fi
  done
}

cmd_sync() {
  local force=false
  local args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force|-f) force=true; shift ;;
      *) args[${#args[@]}]="$1"; shift ;;
    esac
  done

  local target_name
  # An empty array must not be expanded under `set -u` on bash 3.2.
  if [[ ${#args[@]} -gt 0 ]]; then
    target_name=$(resolve_target_arg "${args[@]}")
  else
    target_name=$(resolve_target_arg)
  fi
  local target_info
  target_info=$(get_target "$target_name")
  local target_path="${target_info%%:*}"
  local target_file="${target_info##*:}"
  local project_skills_dir="$PWD/$target_path"
  local fixed=0 ok=0 missing=0 diverged=0

  echo "${BOLD}Syncing hardlinks${RESET} ${DIM}(target: $target_name)${RESET}"

  while IFS=: read -r source_dir skill_name; do
    local source_file="$source_dir/$skill_name/$target_file"
    local dest_dir="$project_skills_dir/$skill_name"
    local dest_file="$dest_dir/$target_file"

    [[ -d "$dest_dir" ]] || continue  # only sync skills already in the project

    if is_hardlinked "$dest_file" "$source_file" 2>/dev/null; then
      ok=$((ok + 1))
    elif ! $force && ! cmp -s "$dest_file" "$source_file"; then
      # A copy that also reads differently is somebody's work, not a broken
      # link. Relinking would delete it, so say so and move on.
      echo "  ${YELLOW}diverged${RESET} $skill_name  ${DIM}(local content differs — kept)${RESET}"
      diverged=$((diverged + 1))
    else
      # A copy whose content still matches: relinking loses nothing.
      mkdir -p "$dest_dir"
      rm -f "$dest_file"
      ln "$source_file" "$dest_file"
      echo "  ${GREEN}relinked${RESET} $skill_name"
      fixed=$((fixed + 1))
    fi

    # Companions are synced whatever the entry file's state was: a skill that
    # grew a references/ upstream reaches its projects through here.
    link_companion_files "$source_dir/$skill_name" "$dest_dir" "$target_file" "$force"
    if [[ $companions_linked -gt 0 ]]; then
      echo "  ${GREEN}relinked${RESET} $skill_name ${DIM}($companions_linked companion files)${RESET}"
      fixed=$((fixed + 1))
    fi
    if [[ $companions_diverged -gt 0 ]]; then
      echo "  ${YELLOW}diverged${RESET} $skill_name ${DIM}($companions_diverged companion files differ — kept)${RESET}"
      diverged=$((diverged + 1))
    fi
  done < <(discover_skills "$target_file")

  echo ""
  echo "  ${GREEN}$ok${RESET} ok, ${YELLOW}$fixed${RESET} relinked, ${YELLOW}$diverged${RESET} diverged"
  if [[ $diverged -gt 0 ]]; then
    echo "  ${DIM}Diverged copies were kept. Decide whether the change belongs upstream,${RESET}"
    echo "  ${DIM}then rerun with ${BOLD}--force${RESET}${DIM} to relink them.${RESET}"
  fi
}

cmd_check() {
  local target_name
  target_name=$(resolve_target_arg "$@")
  local target_info
  target_info=$(get_target "$target_name")
  local target_path="${target_info%%:*}"
  local target_file="${target_info##*:}"
  local project_skills_dir="$PWD/$target_path"
  local ok=0 copies=0 originals=0

  echo "${BOLD}Checking hardlinks${RESET} ${DIM}(target: $target_name)${RESET}"

  [[ -d "$project_skills_dir" ]] || die "No skills directory: $project_skills_dir"

  local discovered
  discovered=$(discover_skills "$target_file")

  for skill_dir in "$project_skills_dir"/*/; do
    [[ -f "$skill_dir/$target_file" ]] || continue
    local skill_name
    skill_name=$(basename "$skill_dir")

    # No `grep | cut` here: under `set -o pipefail` a project-owned skill
    # (no matching source) makes grep exit 1 and kills the whole run.
    local source_dir=""
    local entry
    while IFS= read -r entry; do
      case "$entry" in
        *":$skill_name") source_dir="${entry%:*}"; break ;;
      esac
    done <<< "$discovered"

    if [[ -n "$source_dir" ]]; then
      local source_file="$source_dir/$skill_name/$target_file"
      check_companion_files "$source_dir/$skill_name" "$skill_dir" "$target_file"
      if ! is_hardlinked "$skill_dir/$target_file" "$source_file"; then
        echo "  ${YELLOW}[~]${RESET} $skill_name  ${DIM}(copy, expected hardlink from $source_dir)${RESET}"
        copies=$((copies + 1))
      elif [[ $companions_unlinked -gt 0 ]]; then
        # The entry file is fine, so the skill loads — but a relative link
        # inside it points at a file this project does not have.
        echo "  ${YELLOW}[~]${RESET} $skill_name  ${DIM}($companions_unlinked companion files missing or copies)${RESET}"
        copies=$((copies + 1))
      else
        ok=$((ok + 1))
      fi
    else
      originals=$((originals + 1))
    fi
  done

  echo ""
  echo "  ${GREEN}$ok${RESET} linked, ${YELLOW}$copies${RESET} copies, $originals originals"
  if [[ $copies -gt 0 ]]; then
    echo "  Run ${BOLD}manage-skills sync${RESET} to relink copies"
    echo "  ${DIM}Copies whose content differs are kept; sync names them.${RESET}"
  fi
}

# ── Interactive Mode (fzf or fallback) ───────────────────────────────

cmd_interactive() {
  local target_name
  target_name=$(resolve_target_arg "$@")
  local target_info
  target_info=$(get_target "$target_name")
  local target_path="${target_info%%:*}"
  local target_file="${target_info##*:}"
  local project_skills_dir="$PWD/$target_path"

  # Build skill list
  local -a all_skills=()
  local -a all_sources=()
  local -a all_states=()

  while IFS=: read -r source_dir skill_name; do
    local source_file="$source_dir/$skill_name/$target_file"
    local dest_file="$project_skills_dir/$skill_name/$target_file"
    local state="available"

    if [[ -f "$dest_file" ]]; then
      if is_hardlinked "$dest_file" "$source_file" 2>/dev/null; then
        state="linked"
      else
        state="copy"
      fi
    fi

    all_skills+=("$skill_name")
    all_sources+=("$source_dir")
    all_states+=("$state")
  done < <(discover_skills "$target_file")

  if [[ ${#all_skills[@]} -eq 0 ]]; then
    die "No skills found. Configure sources first: manage-skills sources add <dir>"
  fi

  # Try fzf
  if command -v fzf &>/dev/null; then
    _interactive_fzf "$target_name" "$target_path" "$target_file" "$project_skills_dir"
  else
    _interactive_basic "$target_name" "$target_path" "$target_file" "$project_skills_dir"
  fi
}

_interactive_fzf() {
  local target_name="$1" target_path="$2" target_file="$3" project_skills_dir="$4"

  # Build fzf input
  local fzf_input=""
  local -a preselected=()
  local idx=0

  while IFS=: read -r source_dir skill_name; do
    local source_file="$source_dir/$skill_name/$target_file"
    local dest_file="$project_skills_dir/$skill_name/$target_file"
    local marker=""

    if [[ -f "$dest_file" ]] && is_hardlinked "$dest_file" "$source_file" 2>/dev/null; then
      preselected+=("$skill_name")
    fi

    local short_source="$(shorten "$source_dir")"
    fzf_input+="$skill_name  ← $short_source"$'\n'
    ((idx++))
  done < <(discover_skills "$target_file")

  # Build preselect args for fzf -- we pass the already-linked ones
  local selected
  selected=$(echo -n "$fzf_input" | fzf --multi --ansi \
    --header="Toggle skills with TAB, confirm with ENTER" \
    --prompt="Skills for $(basename "$PWD") > " \
    --preview="head -20 {+1}/$target_file 2>/dev/null || echo 'Not yet linked'" \
    --preview-window=right:50%:wrap \
    $(for s in "${preselected[@]}"; do echo -n " --bind=start:select-all"; break; done) \
    | awk '{print $1}') || return 0

  # Determine what to link and unlink
  local -a to_link=()
  local -a to_unlink=()

  while IFS=: read -r source_dir skill_name; do
    local dest_file="$project_skills_dir/$skill_name/$target_file"
    local source_file="$source_dir/$skill_name/$target_file"
    local is_selected=false
    while IFS= read -r sel; do
      [[ "$sel" == "$skill_name" ]] && is_selected=true && break
    done <<< "$selected"

    local is_linked=false
    if [[ -f "$dest_file" ]] && is_hardlinked "$dest_file" "$source_file" 2>/dev/null; then
      is_linked=true
    fi

    if $is_selected && ! $is_linked; then
      to_link+=("$skill_name")
    elif ! $is_selected && $is_linked; then
      to_unlink+=("$skill_name")
    fi
  done < <(discover_skills "$target_file")

  # Apply
  for s in "${to_link[@]}"; do
    cmd_link "$s" --target "$target_name"
  done
  for s in "${to_unlink[@]}"; do
    cmd_unlink "$s" --target "$target_name"
  done
}

_interactive_basic() {
  local target_name="$1" target_path="$2" target_file="$3" project_skills_dir="$4"

  local -a names=() sources=() states=()

  while IFS=: read -r source_dir skill_name; do
    local source_file="$source_dir/$skill_name/$target_file"
    local dest_file="$project_skills_dir/$skill_name/$target_file"
    local state="[ ]"

    if [[ -f "$dest_file" ]]; then
      if is_hardlinked "$dest_file" "$source_file" 2>/dev/null; then
        state="[*]"
      else
        state="[~]"
      fi
    fi

    names+=("$skill_name")
    sources+=("$source_dir")
    states+=("$state")
  done < <(discover_skills "$target_file")

  local -a original_states=("${states[@]}")
  local width
  width=$(term_width)

  while true; do
    clear 2>/dev/null || true
    echo "${BOLD}Skills for $(basename "$PWD")${RESET}"
    echo ""

    local total=${#names[@]}
    local numw=${#total}
    local group="" buf="" i color
    for ((i = 0; i < total; i++)); do
      if [[ "${sources[$i]}" != "$group" ]]; then
        if [[ -n "$buf" ]]; then
          printf '%s' "$buf" | print_grid "$width"
          echo ""
        fi
        buf=""
        group="${sources[$i]}"
        echo "${BOLD}$(shorten "$group")${RESET}"
      fi
      case "${states[$i]}" in
        '[*]') color="$GREEN" ;;
        '[~]') color="$YELLOW" ;;
        *)     color="$DIM" ;;
      esac
      buf="$buf$((numw + 6 + ${#names[$i]}))"$'\t'"${DIM}$(printf "%${numw}d" $((i + 1))))${RESET} $color${states[$i]}$RESET ${names[$i]}"$'\n'
    done
    [[ -n "$buf" ]] && printf '%s' "$buf" | print_grid "$width"

    echo ""
    echo "${DIM}Enter number to toggle, 'a' to apply changes, 'q' to quit${RESET}"
    read -rp "> " input

    case "$input" in
      q|Q) return ;;
      a|A)
        for i in "${!names[@]}"; do
          if [[ "${states[$i]}" != "${original_states[$i]}" ]]; then
            if [[ "${states[$i]}" == "[*]" ]]; then
              cmd_link "${names[$i]}" --target "$target_name"
            else
              cmd_unlink "${names[$i]}" --target "$target_name"
            fi
          fi
        done
        return
        ;;
      *)
        if [[ "$input" =~ ^[0-9]+$ ]] && (( input >= 1 && input <= ${#names[@]} )); then
          local idx=$((input - 1))
          if [[ "${states[$idx]}" == "[*]" ]]; then
            states[$idx]="[ ]"
          else
            states[$idx]="[*]"
          fi
        fi
        ;;
    esac
  done
}

