#!/usr/bin/env bash
set -euo pipefail

VERSION="0.3.0"
SELF_REPO="${MANAGE_SKILLS_REPO:-Getty/manage-skills}"
# Skills this tool ships. Kept in sync with .claude/skills/ by the smoke tests.
SELF_SKILLS="manage-skills manage-skills-drift-triage"
CONFIG_DIR="${MANAGE_SKILLS_HOME:-$HOME/.manage-skills}"
SOURCES_FILE="$CONFIG_DIR/sources"
TARGETS_FILE="$CONFIG_DIR/targets"

# Colors (disabled if not a terminal)
if [[ -t 1 ]]; then
  BOLD=$'\033[1m' DIM=$'\033[2m' GREEN=$'\033[32m' YELLOW=$'\033[33m'
  CYAN=$'\033[36m' RED=$'\033[31m' RESET=$'\033[0m'
else
  BOLD='' DIM='' GREEN='' YELLOW='' CYAN='' RED='' RESET=''
fi

die() { echo "${RED}error:${RESET} $*" >&2; exit 1; }
info() { echo "${CYAN}$*${RESET}"; }
warn() { echo "${YELLOW}$*${RESET}"; }
# The tilde comes from a variable: bash 3.2 keeps the backslash in
# "${1//$HOME/\~}" and emits \~/... , which never expands back.
shorten() { local tilde='~'; echo "${1//$HOME/$tilde}"; }

# ── Config ──────────────────────────────────────────────────────────

ensure_config() {
  [[ -d "$CONFIG_DIR" && -f "$TARGETS_FILE" && -f "$SOURCES_FILE" ]] && return
  if [[ ! -d "$CONFIG_DIR" ]]; then
    mkdir -p "$CONFIG_DIR"
    info "Created $CONFIG_DIR"
  fi
  # Write default target
  if [[ ! -f "$TARGETS_FILE" ]]; then
    echo "claude:.claude/skills:SKILL.md" > "$TARGETS_FILE"
    info "Default target: claude (.claude/skills/SKILL.md)"
  fi
  [[ -f "$SOURCES_FILE" ]] && return
  # Empty sources file with comment
  cat > "$SOURCES_FILE" << 'SOURCES'
# manage-skills source directories
# One directory per line. These are scanned for skill files.
# Order is priority: when two sources provide the same skill name, the first wins.
# Lines starting with # are ignored. ~ is expanded.
# A trailing "# label" describes the source and shows up in 'locations'.
#
# Example:
# ~/dev/shared-skills        # Cross-language: K8s, CI, tools
# ~/dev/perl/shared-skills   # Shared Perl ecosystem
SOURCES
  warn "No sources configured yet. Run: manage-skills sources add ~/dev/shared-skills"
}

expand_path() {
  local p="$1"
  p="${p/#\~/$HOME}"
  echo "$p"
}

trim() {
  local v="$1"
  v="${v#"${v%%[![:space:]]*}"}"
  echo "${v%"${v##*[![:space:]]}"}"
}

# Splits a source line into SOURCE_PATH and SOURCE_LABEL. A source line may
# carry a trailing "# label" saying what lives there:
#   ~/dev/shared-skills   # Cross-language: K8s, CI, tools
SOURCE_PATH=""
SOURCE_LABEL=""
parse_source_line() {
  local line="$1"
  SOURCE_LABEL=""
  [[ "$line" == *"#"* ]] && SOURCE_LABEL=$(trim "${line#*#}")
  SOURCE_PATH=$(trim "${line%%#*}")
}

# Emits "expanded_path<TAB>label" per configured source, existing ones only.
read_source_lines() {
  [[ -f "$SOURCES_FILE" ]] || return
  local line expanded
  while IFS= read -r line; do
    [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
    parse_source_line "$line"
    [[ -z "$SOURCE_PATH" ]] && continue
    expanded=$(expand_path "$SOURCE_PATH")
    [[ -d "$expanded" ]] && printf '%s\t%s\n' "$expanded" "$SOURCE_LABEL"
  done < "$SOURCES_FILE"
}

read_sources() {
  local path label
  while IFS=$'\t' read -r path label; do
    echo "$path"
  done < <(read_source_lines)
}

# All skills a source directory provides, in glob order, without dedup.
list_source_skills() {
  local source_dir="$1" target_file="${2:-SKILL.md}"
  local skill_dir
  for skill_dir in "$source_dir"/*/; do
    [[ -f "$skill_dir/$target_file" ]] || continue
    basename "$skill_dir"
  done
}

read_targets() {
  [[ -f "$TARGETS_FILE" ]] || return
  while IFS=: read -r name path file; do
    [[ -z "$name" || "$name" =~ ^[[:space:]]*# ]] && continue
    echo "$name:$path:$file"
  done < "$TARGETS_FILE"
}

# Resolves the target for commands that take no skill arguments. Accepts both
# `<command> <target>` and `<command> --target <name>`; the help text advertises
# the flag globally, so every command honours it.
resolve_target_arg() {
  local t="claude"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target|-t)
        [[ -n "${2:-}" ]] || die "Missing value for $1"
        t="$2"; shift 2 ;;
      -*)          shift ;;
      *)           t="$1"; shift ;;
    esac
  done
  echo "$t"
}

get_target() {
  local want="${1:-claude}"
  while IFS=: read -r name path file; do
    [[ "$name" == "$want" ]] && echo "$path:$file" && return
  done < <(read_targets)
  die "Unknown target '$want'. Check $TARGETS_FILE"
}

# ── Skill Discovery ─────────────────────────────────────────────────

# Find all skills across all sources. Output: source_dir:skill_name
# Deduplicates by skill name — first source wins (so order in sources file matters).
discover_skills() {
  local target_file="${1:-SKILL.md}"
  local seen=""
  while IFS= read -r source_dir; do
    for skill_dir in "$source_dir"/*/; do
      [[ -f "$skill_dir/$target_file" ]] || continue
      local skill_name
      skill_name=$(basename "$skill_dir")
      case ",$seen," in *,"$skill_name",*) continue ;; esac
      seen="$seen,$skill_name"
      echo "$source_dir:$skill_name"
    done
  done < <(read_sources)
}

# Check if a skill file in the project is a hardlink to the source
is_hardlinked() {
  local project_file="$1"
  local source_file="$2"
  [[ -f "$project_file" ]] || return 1
  [[ -f "$source_file" ]] || return 1
  local inode_p inode_s
  inode_p=$(stat -c %i "$project_file" 2>/dev/null || stat -f %i "$project_file" 2>/dev/null)
  inode_s=$(stat -c %i "$source_file" 2>/dev/null || stat -f %i "$source_file" 2>/dev/null)
  [[ "$inode_p" == "$inode_s" ]]
}

# ── Layout ───────────────────────────────────────────────────────────

term_width() {
  # No `[[ -t 1 ]]` guard: this runs inside $(...), where stdout is a pipe.
  # tput falls back to the terminfo default when there is no terminal.
  local w=""
  w=$(tput cols 2>/dev/null || true)
  [[ -n "$w" ]] || w="${COLUMNS:-}"
  case "$w" in
    ''|*[!0-9]*) w=80 ;;
  esac
  [[ "$w" -lt 24 ]] && w=80
  echo "$w"
}

# Reads "<visible_width>\t<rendered_text>" lines from stdin and prints them as
# a multi-column grid, filling column-major like `ls`. The visible width is
# passed in rather than measured: the rendered text carries ANSI escapes and a
# multibyte ● marker, both of which ${#var} counts wrong.
print_grid() {
  local term_w="$1" gutter="${2:-2}"
  local cell_w=() cell_txt=()
  local lw lt
  while IFS=$'\t' read -r lw lt; do
    cell_w[${#cell_w[@]}]="$lw"
    cell_txt[${#cell_txt[@]}]="$lt"
  done
  local n=${#cell_w[@]}
  [[ "$n" -eq 0 ]] && return

  local maxw=0 i
  for ((i = 0; i < n; i++)); do
    [[ "${cell_w[$i]}" -gt "$maxw" ]] && maxw=${cell_w[$i]}
  done

  local colw=$((maxw + gutter))
  local cols=$(( (term_w - 2) / colw ))
  [[ "$cols" -lt 1 ]] && cols=1
  [[ "$cols" -gt "$n" ]] && cols=$n
  local rows=$(( (n + cols - 1) / cols ))

  local row col idx
  for ((row = 0; row < rows; row++)); do
    printf "  "
    for ((col = 0; col < cols; col++)); do
      idx=$((col * rows + row))
      [[ "$idx" -ge "$n" ]] && continue
      printf "%s" "${cell_txt[$idx]}"
      # no trailing padding on the last cell of a row
      [[ $((idx + rows)) -lt "$n" ]] && printf "%*s" "$((colw - ${cell_w[$idx]}))" ""
    done
    printf "\n"
  done
}

# Sets MARKER and MARKER_COLOR for a skill's link state.
# Globals instead of a subshell: this runs once per skill.
MARKER=""
MARKER_COLOR=""
skill_marker() {
  local project_file="$1" source_file="$2"
  if [[ -f "$project_file" ]]; then
    if is_hardlinked "$project_file" "$source_file" 2>/dev/null; then
      MARKER="[*]"; MARKER_COLOR="$GREEN"
    else
      MARKER="[~]"; MARKER_COLOR="$YELLOW"
    fi
  else
    MARKER="[ ]"; MARKER_COLOR="$DIM"
  fi
}

# ── Commands ─────────────────────────────────────────────────────────

cmd_init() {
  ensure_config
  if [[ -f "$SOURCES_FILE" ]] && grep -qv '^#' "$SOURCES_FILE" 2>/dev/null; then
    info "Config already exists at $CONFIG_DIR"
  fi
  echo ""
  info "Next steps:"
  echo "  manage-skills sources add ~/dev/shared-skills"
  echo "  manage-skills sources add ~/dev/perl/shared-skills"
  echo "  cd ~/your-project && manage-skills"
}

cmd_sources() {
  local subcmd="${1:-list}"
  shift 2>/dev/null || true

  case "$subcmd" in
    list)
      if [[ ! -f "$SOURCES_FILE" ]]; then
        warn "No sources configured. Run: manage-skills init"
        return
      fi
      echo "${BOLD}Skill sources:${RESET} ${DIM}(first match wins)${RESET}"
      while IFS= read -r line; do
        [[ -z "$line" || "$line" =~ ^[[:space:]]*# ]] && continue
        parse_source_line "$line"
        [[ -z "$SOURCE_PATH" ]] && continue
        local expanded note=""
        [[ -n "$SOURCE_LABEL" ]] && note=" — $SOURCE_LABEL"
        expanded=$(expand_path "$SOURCE_PATH")
        if [[ -d "$expanded" ]]; then
          local count
          count=$(list_source_skills "$expanded" | wc -l | tr -d ' ')
          echo "  ${GREEN}●${RESET} $SOURCE_PATH  ${DIM}($count skills)$note${RESET}"
        else
          echo "  ${RED}●${RESET} $SOURCE_PATH  ${DIM}(not found)$note${RESET}"
        fi
      done < "$SOURCES_FILE"
      ;;
    add)
      [[ -z "${1:-}" ]] && die "Usage: manage-skills sources add <directory> [label...]"
      local dir="$1"
      shift
      local label="$*"
      local expanded
      expanded=$(expand_path "$dir")
      [[ -d "$expanded" ]] || die "Directory not found: $expanded"
      # Check if already in sources
      if grep -qF "$dir" "$SOURCES_FILE" 2>/dev/null; then
        warn "Already in sources: $dir"
        return
      fi
      if [[ -n "$label" ]]; then
        printf '%s   # %s\n' "$dir" "$label" >> "$SOURCES_FILE"
        info "Added: $dir — $label"
      else
        echo "$dir" >> "$SOURCES_FILE"
        info "Added: $dir"
      fi
      ;;
    remove)
      [[ -z "${1:-}" ]] && die "Usage: manage-skills sources remove <directory>"
      local dir="$1"
      local tmp
      tmp=$(mktemp)
      grep -vF "$dir" "$SOURCES_FILE" > "$tmp" || true
      mv "$tmp" "$SOURCES_FILE"
      info "Removed: $dir"
      ;;
    *)
      die "Unknown sources command: $subcmd (use list, add, remove)"
      ;;
  esac
}

cmd_targets() {
  local subcmd="${1:-list}"
  shift 2>/dev/null || true

  case "$subcmd" in
    list)
      echo "${BOLD}Configured targets:${RESET}"
      while IFS=: read -r name path file; do
        [[ -z "$name" || "$name" =~ ^[[:space:]]*# ]] && continue
        echo "  ${GREEN}$name${RESET}  →  $path/$file"
      done < <(read_targets)
      ;;
    add)
      [[ -z "${1:-}" || -z "${2:-}" || -z "${3:-}" ]] && die "Usage: manage-skills targets add <name> <path> <file>"
      echo "$1:$2:$3" >> "$TARGETS_FILE"
      info "Added target: $1 → $2/$3"
      ;;
    *)
      die "Unknown targets command: $subcmd (use list, add)"
      ;;
  esac
}

cmd_list() {
  local target_name
  target_name=$(resolve_target_arg "$@")
  local target_info
  target_info=$(get_target "$target_name")
  local target_path="${target_info%%:*}"
  local target_file="${target_info##*:}"
  local project_skills_dir="$PWD/$target_path"

  # Grid only on a terminal — piped output stays one skill per line so it
  # keeps working with grep/awk.
  local grid=false
  [[ -t 1 ]] && grid=true
  local width
  width=$(term_width)

  echo "${BOLD}Available skills${RESET} ${DIM}(target: $target_name)${RESET}"
  $grid || echo ""

  local has_skills=false seen="" group="" buf=""

  while IFS=: read -r source_dir skill_name; do
    has_skills=true
    seen="$seen,$skill_name"
    skill_marker "$project_skills_dir/$skill_name/$target_file" \
                 "$source_dir/$skill_name/$target_file"

    if $grid; then
      if [[ "$source_dir" != "$group" ]]; then
        [[ -n "$buf" ]] && printf '%s' "$buf" | print_grid "$width"
        buf=""
        group="$source_dir"
        echo ""
        echo "${BOLD}$(shorten "$source_dir")${RESET}"
      fi
      buf="$buf$((4 + ${#skill_name}))	$MARKER_COLOR$MARKER$RESET $skill_name"$'\n'
    else
      case "$MARKER" in
        '[~]') echo "  ${MARKER_COLOR}${MARKER}${RESET} $skill_name  ${DIM}(local copy, not linked)${RESET}" ;;
        *)     echo "  ${MARKER_COLOR}${MARKER}${RESET} $skill_name  ${DIM}← $(shorten "$source_dir")${RESET}" ;;
      esac
    fi
  done < <(discover_skills "$target_file")

  [[ -n "$buf" ]] && printf '%s' "$buf" | print_grid "$width"
  buf=""

  # Originals: skills the project owns, with no source providing that name.
  if [[ -d "$project_skills_dir" ]]; then
    local first_original=true
    for skill_dir in "$project_skills_dir"/*/; do
      [[ -f "$skill_dir/$target_file" ]] || continue
      local skill_name
      skill_name=$(basename "$skill_dir")
      case ",$seen," in *,"$skill_name",*) continue ;; esac
      if $grid; then
        if $first_original; then
          first_original=false
          echo ""
          echo "${BOLD}This project${RESET} ${DIM}(source of truth)${RESET}"
        fi
        buf="$buf$((4 + ${#skill_name}))	 ${CYAN}●${RESET} $skill_name"$'\n'
      else
        echo "   ●  $skill_name  ${DIM}(original)${RESET}"
      fi
    done
    [[ -n "$buf" ]] && printf '%s' "$buf" | print_grid "$width"
  fi

  if ! $has_skills; then
    warn "No skills found in any source. Run: manage-skills sources add <dir>"
  fi

  echo ""
  echo "${DIM}Legend: [*] hardlinked  [~] local copy  [ ] available  ● original${RESET}"
}

cmd_locations() {
  local target_name
  target_name=$(resolve_target_arg "$@")
  local target_info
  target_info=$(get_target "$target_name")
  local target_path="${target_info%%:*}"
  local target_file="${target_info##*:}"
  local project_skills_dir="$PWD/$target_path"

  local grid=false
  [[ -t 1 ]] && grid=true
  local width
  width=$(term_width)

  echo "${BOLD}Skill locations${RESET} ${DIM}(target: $target_name)${RESET}"

  local seen="" shadowed=0 any=false
  local source_dir label buf name skill_dir

  while IFS=$'\t' read -r source_dir label; do
    any=true
    echo ""
    if [[ -n "$label" ]]; then
      echo "${BOLD}$(shorten "$source_dir")${RESET}  ${DIM}— $label${RESET}"
    else
      echo "${BOLD}$(shorten "$source_dir")${RESET}"
    fi

    buf=""
    while IFS= read -r name; do
      case ",$seen," in
        *,"$name",*)
          # An earlier source already provides this name, so this copy never
          # wins a link or a sync — the silent shadowing case.
          shadowed=$((shadowed + 1))
          buf="$buf$((${#name} + 1))"$'\t'"${DIM}$name*${RESET}"$'\n'
          ;;
        *)
          seen="$seen,$name"
          buf="$buf${#name}"$'\t'"$name"$'\n'
          ;;
      esac
    done < <(list_source_skills "$source_dir" "$target_file")

    if [[ -z "$buf" ]]; then
      echo "  ${DIM}(no skills)${RESET}"
    elif $grid; then
      printf '%s' "$buf" | print_grid "$width"
    else
      printf '%s' "$buf" | cut -f2- | sed 's/^/  /'
    fi
  done < <(read_source_lines)

  if ! $any; then
    echo ""
    warn "No sources configured. Run: manage-skills sources add <dir> [label]"
  fi

  # Skills this project owns outright — no source provides that name.
  if [[ -d "$project_skills_dir" ]]; then
    buf=""
    for skill_dir in "$project_skills_dir"/*/; do
      [[ -f "$skill_dir/$target_file" ]] || continue
      name=$(basename "$skill_dir")
      case ",$seen," in *,"$name",*) continue ;; esac
      buf="$buf${#name}"$'\t'"${CYAN}$name${RESET}"$'\n'
    done
    if [[ -n "$buf" ]]; then
      echo ""
      echo "${BOLD}Owned by $(basename "$PWD")${RESET} ${DIM}(source of truth — no source provides these)${RESET}"
      if $grid; then
        printf '%s' "$buf" | print_grid "$width"
      else
        printf '%s' "$buf" | cut -f2- | sed 's/^/  /'
      fi
    fi
  fi

  if [[ $shadowed -gt 0 ]]; then
    echo ""
    echo "${DIM}* shadowed — an earlier source already provides that name, so this${RESET}"
    echo "${DIM}  copy never wins a link or a sync. Reorder $SOURCES_FILE to change it.${RESET}"
  fi

  # Hand-written context that cannot be derived: naming conventions, which
  # skills pair up, which ones are conditional.
  local notes_file="$CONFIG_DIR/notes.md"
  echo ""
  if [[ -f "$notes_file" ]]; then
    echo "${BOLD}Notes${RESET} ${DIM}$(shorten "$notes_file")${RESET}"
    sed 's/^/  /' "$notes_file"
  else
    echo "${DIM}Conventions and other hand-written context: create $(shorten "$notes_file")${RESET}"
  fi
}

# ── Self ─────────────────────────────────────────────────────────────

# Absolute directory of the running script, following symlinks. install.sh
# symlinks the script into a bin dir in dev mode, so $0's own directory is the
# bin dir, not the checkout.
self_script_path() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir=$(cd -P "$(dirname "$src")" && pwd)
    src=$(readlink "$src")
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  echo "$(cd -P "$(dirname "$src")" && pwd)/$(basename "$src")"
}

# clone | plugin | standalone — how this copy got here decides how it updates.
self_install_kind() {
  local dir
  dir=$(dirname "$(self_script_path)")
  case "$dir" in
    */plugins/cache/*) echo "plugin"; return ;;
  esac
  if git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "clone"
  else
    echo "standalone"
  fi
}

# Where this installation's own skills live, if anywhere.
self_skills_dir() {
  local dir
  dir=$(dirname "$(self_script_path)")
  [[ -d "$dir/skills" ]] && { echo "$dir/skills"; return; }
  [[ -d "$dir/.claude/skills" ]] && { echo "$dir/.claude/skills"; return; }
  [[ -d "$CONFIG_DIR/skills" ]] && { echo "$CONFIG_DIR/skills"; return; }
  return 1
}

fetch_url() {
  local url="$1" dest="$2"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$url" -o "$dest"
  elif command -v wget >/dev/null 2>&1; then
    wget -qO "$dest" "$url"
  else
    die "Neither curl nor wget found — cannot download from $SELF_REPO"
  fi
}

# Downloads the shipped skills into the config dir, so a standalone install
# (curl one-liner, no checkout) still has them.
self_download_skills() {
  local dest="$CONFIG_DIR/skills"
  local base="https://raw.githubusercontent.com/$SELF_REPO/main/.claude/skills"
  local name
  for name in $SELF_SKILLS; do
    mkdir -p "$dest/$name"
    # `cat >` over the existing file so a hardlinked copy keeps its inode.
    local tmp
    tmp=$(mktemp)
    if fetch_url "$base/$name/SKILL.md" "$tmp"; then
      cat "$tmp" > "$dest/$name/SKILL.md"
      rm -f "$tmp"
      echo "  ${GREEN}fetched${RESET} $name"
    else
      rm -f "$tmp"
      warn "  could not fetch $name"
    fi
  done
  echo "$dest"
}

cmd_self() {
  local subcmd="${1:-status}"
  shift 2>/dev/null || true

  local script_path kind skills_dir
  script_path=$(self_script_path)
  kind=$(self_install_kind)
  skills_dir=$(self_skills_dir || true)

  case "$subcmd" in
    status)
      echo "${BOLD}manage-skills${RESET} v$VERSION"
      echo "  script    $(shorten "$script_path")  ${DIM}($kind)${RESET}"
      echo "  config    $(shorten "$CONFIG_DIR")"
      if [[ -n "$skills_dir" ]]; then
        echo "  skills    $(shorten "$skills_dir")  ${DIM}($(list_source_skills "$skills_dir" | wc -l | tr -d ' ') shipped)${RESET}"
        if read_sources | grep -qxF "$skills_dir"; then
          echo "            ${GREEN}registered as a source${RESET}"
        else
          echo "            ${YELLOW}not registered${RESET} — run: manage-skills self install"
        fi
      else
        echo "  skills    ${YELLOW}not present${RESET} — run: manage-skills self install"
      fi
      ;;
    install)
      if [[ -z "$skills_dir" ]]; then
        info "Fetching shipped skills from $SELF_REPO"
        skills_dir=$(self_download_skills | tail -1)
      fi
      if read_sources | grep -qxF "$skills_dir"; then
        info "Already a source: $(shorten "$skills_dir")"
      else
        # Appended, so it stays lowest priority — your own skills win.
        # Absolute, not shortened: what a config stores and what a terminal
        # shows are different jobs.
        printf '%s   # %s\n' "$skills_dir" "Shipped with manage-skills" >> "$SOURCES_FILE"
        info "Registered as a source: $(shorten "$skills_dir")"
      fi
      echo ""
      echo "Link them into a project with:"
      echo "  manage-skills link $SELF_SKILLS"
      ;;
    update)
      case "$kind" in
        clone)
          local dir
          dir=$(dirname "$script_path")
          info "Installed from a checkout — update it with git:"
          echo "  git -C $(shorten "$dir") pull"
          ;;
        plugin)
          info "Installed as a Claude Code plugin — update it from Claude Code:"
          echo "  /plugin update manage-skills"
          ;;
        standalone)
          local tmp
          tmp=$(mktemp)
          info "Fetching https://raw.githubusercontent.com/$SELF_REPO/main/manage-skills"
          fetch_url "https://raw.githubusercontent.com/$SELF_REPO/main/manage-skills" "$tmp" \
            || { rm -f "$tmp"; die "Download failed"; }
          bash -n "$tmp" 2>/dev/null || { rm -f "$tmp"; die "Downloaded script failed the syntax check — not installing"; }
          local new_version
          new_version=$(grep -m1 '^VERSION=' "$tmp" | cut -d'"' -f2)
          if [[ "$new_version" == "$VERSION" ]]; then
            rm -f "$tmp"
            info "Already on the latest version ($VERSION)"
            return
          fi
          # exec so the running shell stops reading this file before it changes.
          echo "  ${GREEN}updating${RESET} $VERSION → $new_version"
          exec sh -c "cat '$tmp' > '$script_path' && chmod +x '$script_path' && rm -f '$tmp' && echo '  manage-skills is now $new_version'"
          ;;
      esac
      if [[ -n "$skills_dir" && "$skills_dir" == "$CONFIG_DIR/skills" ]]; then
        echo ""
        info "Refreshing shipped skills"
        self_download_skills >/dev/null
        info "Run 'manage-skills sync' in your projects to propagate"
      fi
      ;;
    *)
      die "Unknown self command: $subcmd (use status, install, update)"
      ;;
  esac
}

cmd_link() {
  local target_name="claude"
  local skills=()

  # Parse args
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target|-t)
        [[ -n "${2:-}" ]] || die "Missing value for $1"
        target_name="$2"; shift 2 ;;
      *) skills+=("$1"); shift ;;
    esac
  done

  [[ ${#skills[@]} -eq 0 ]] && die "Usage: manage-skills link <skill> [skill...] [--target name]"

  local target_info
  target_info=$(get_target "$target_name")
  local target_path="${target_info%%:*}"
  local target_file="${target_info##*:}"
  local project_skills_dir="$PWD/$target_path"

  for skill_name in "${skills[@]}"; do
    local found=false
    while IFS=: read -r source_dir sname; do
      [[ "$sname" == "$skill_name" ]] || continue
      found=true
      local source_file="$source_dir/$skill_name/$target_file"
      local dest_dir="$project_skills_dir/$skill_name"
      local dest_file="$dest_dir/$target_file"

      if is_hardlinked "$dest_file" "$source_file" 2>/dev/null; then
        info "$skill_name: already linked"
        break
      fi

      mkdir -p "$dest_dir"
      rm -f "$dest_file"
      ln "$source_file" "$dest_file"
      echo "  ${GREEN}linked${RESET} $skill_name ← $source_dir"
      break
    done < <(discover_skills "$target_file")

    if ! $found; then
      warn "$skill_name: not found in any source"
    fi
  done
}

cmd_unlink() {
  local target_name="claude"
  local skills=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target|-t)
        [[ -n "${2:-}" ]] || die "Missing value for $1"
        target_name="$2"; shift 2 ;;
      *) skills+=("$1"); shift ;;
    esac
  done

  [[ ${#skills[@]} -eq 0 ]] && die "Usage: manage-skills unlink <skill> [skill...] [--target name]"

  local target_info
  target_info=$(get_target "$target_name")
  local target_path="${target_info%%:*}"
  local target_file="${target_info##*:}"
  local project_skills_dir="$PWD/$target_path"

  for skill_name in "${skills[@]}"; do
    local dest_dir="$project_skills_dir/$skill_name"
    if [[ -d "$dest_dir" ]]; then
      rm -rf "$dest_dir"
      echo "  ${RED}unlinked${RESET} $skill_name"
    else
      warn "$skill_name: not found in project"
    fi
  done
}

cmd_sync() {
  local target_name
  target_name=$(resolve_target_arg "$@")
  local target_info
  target_info=$(get_target "$target_name")
  local target_path="${target_info%%:*}"
  local target_file="${target_info##*:}"
  local project_skills_dir="$PWD/$target_path"
  local fixed=0 ok=0 missing=0

  echo "${BOLD}Syncing hardlinks${RESET} ${DIM}(target: $target_name)${RESET}"

  while IFS=: read -r source_dir skill_name; do
    local source_file="$source_dir/$skill_name/$target_file"
    local dest_dir="$project_skills_dir/$skill_name"
    local dest_file="$dest_dir/$target_file"

    [[ -d "$dest_dir" ]] || continue  # only sync skills already in the project

    if is_hardlinked "$dest_file" "$source_file" 2>/dev/null; then
      ok=$((ok + 1))
    else
      # File exists but is a copy, not a hardlink — re-link
      mkdir -p "$dest_dir"
      rm -f "$dest_file"
      ln "$source_file" "$dest_file"
      echo "  ${GREEN}relinked${RESET} $skill_name"
      fixed=$((fixed + 1))
    fi
  done < <(discover_skills "$target_file")

  echo ""
  echo "  ${GREEN}$ok${RESET} ok, ${YELLOW}$fixed${RESET} relinked"
}

cmd_check() {
  local target_name
  target_name=$(resolve_target_arg "$@")
  local target_info
  target_info=$(get_target "$target_name")
  local target_path="${target_info%%:*}"
  local target_file="${target_info##*:}"
  local project_skills_dir="$PWD/$target_path"
  local ok=0 copies=0 originals=0

  echo "${BOLD}Checking hardlinks${RESET} ${DIM}(target: $target_name)${RESET}"

  [[ -d "$project_skills_dir" ]] || die "No skills directory: $project_skills_dir"

  local discovered
  discovered=$(discover_skills "$target_file")

  for skill_dir in "$project_skills_dir"/*/; do
    [[ -f "$skill_dir/$target_file" ]] || continue
    local skill_name
    skill_name=$(basename "$skill_dir")

    # No `grep | cut` here: under `set -o pipefail` a project-owned skill
    # (no matching source) makes grep exit 1 and kills the whole run.
    local source_dir=""
    local entry
    while IFS= read -r entry; do
      case "$entry" in
        *":$skill_name") source_dir="${entry%:*}"; break ;;
      esac
    done <<< "$discovered"

    if [[ -n "$source_dir" ]]; then
      local source_file="$source_dir/$skill_name/$target_file"
      if is_hardlinked "$skill_dir/$target_file" "$source_file"; then
        ok=$((ok + 1))
      else
        echo "  ${YELLOW}[~]${RESET} $skill_name  ${DIM}(copy, expected hardlink from $source_dir)${RESET}"
        copies=$((copies + 1))
      fi
    else
      originals=$((originals + 1))
    fi
  done

  echo ""
  echo "  ${GREEN}$ok${RESET} linked, ${YELLOW}$copies${RESET} copies, $originals originals"
  if [[ $copies -gt 0 ]]; then
    echo "  Run ${BOLD}manage-skills sync${RESET} to fix copies"
  fi
}

# ── Interactive Mode (fzf or fallback) ───────────────────────────────

cmd_interactive() {
  local target_name
  target_name=$(resolve_target_arg "$@")
  local target_info
  target_info=$(get_target "$target_name")
  local target_path="${target_info%%:*}"
  local target_file="${target_info##*:}"
  local project_skills_dir="$PWD/$target_path"

  # Build skill list
  local -a all_skills=()
  local -a all_sources=()
  local -a all_states=()

  while IFS=: read -r source_dir skill_name; do
    local source_file="$source_dir/$skill_name/$target_file"
    local dest_file="$project_skills_dir/$skill_name/$target_file"
    local state="available"

    if [[ -f "$dest_file" ]]; then
      if is_hardlinked "$dest_file" "$source_file" 2>/dev/null; then
        state="linked"
      else
        state="copy"
      fi
    fi

    all_skills+=("$skill_name")
    all_sources+=("$source_dir")
    all_states+=("$state")
  done < <(discover_skills "$target_file")

  if [[ ${#all_skills[@]} -eq 0 ]]; then
    die "No skills found. Configure sources first: manage-skills sources add <dir>"
  fi

  # Try fzf
  if command -v fzf &>/dev/null; then
    _interactive_fzf "$target_name" "$target_path" "$target_file" "$project_skills_dir"
  else
    _interactive_basic "$target_name" "$target_path" "$target_file" "$project_skills_dir"
  fi
}

_interactive_fzf() {
  local target_name="$1" target_path="$2" target_file="$3" project_skills_dir="$4"

  # Build fzf input
  local fzf_input=""
  local -a preselected=()
  local idx=0

  while IFS=: read -r source_dir skill_name; do
    local source_file="$source_dir/$skill_name/$target_file"
    local dest_file="$project_skills_dir/$skill_name/$target_file"
    local marker=""

    if [[ -f "$dest_file" ]] && is_hardlinked "$dest_file" "$source_file" 2>/dev/null; then
      preselected+=("$skill_name")
    fi

    local short_source="$(shorten "$source_dir")"
    fzf_input+="$skill_name  ← $short_source"$'\n'
    ((idx++))
  done < <(discover_skills "$target_file")

  # Build preselect args for fzf -- we pass the already-linked ones
  local selected
  selected=$(echo -n "$fzf_input" | fzf --multi --ansi \
    --header="Toggle skills with TAB, confirm with ENTER" \
    --prompt="Skills for $(basename "$PWD") > " \
    --preview="head -20 {+1}/$target_file 2>/dev/null || echo 'Not yet linked'" \
    --preview-window=right:50%:wrap \
    $(for s in "${preselected[@]}"; do echo -n " --bind=start:select-all"; break; done) \
    | awk '{print $1}') || return 0

  # Determine what to link and unlink
  local -a to_link=()
  local -a to_unlink=()

  while IFS=: read -r source_dir skill_name; do
    local dest_file="$project_skills_dir/$skill_name/$target_file"
    local source_file="$source_dir/$skill_name/$target_file"
    local is_selected=false
    while IFS= read -r sel; do
      [[ "$sel" == "$skill_name" ]] && is_selected=true && break
    done <<< "$selected"

    local is_linked=false
    if [[ -f "$dest_file" ]] && is_hardlinked "$dest_file" "$source_file" 2>/dev/null; then
      is_linked=true
    fi

    if $is_selected && ! $is_linked; then
      to_link+=("$skill_name")
    elif ! $is_selected && $is_linked; then
      to_unlink+=("$skill_name")
    fi
  done < <(discover_skills "$target_file")

  # Apply
  for s in "${to_link[@]}"; do
    cmd_link "$s" --target "$target_name"
  done
  for s in "${to_unlink[@]}"; do
    cmd_unlink "$s" --target "$target_name"
  done
}

_interactive_basic() {
  local target_name="$1" target_path="$2" target_file="$3" project_skills_dir="$4"

  local -a names=() sources=() states=()

  while IFS=: read -r source_dir skill_name; do
    local source_file="$source_dir/$skill_name/$target_file"
    local dest_file="$project_skills_dir/$skill_name/$target_file"
    local state="[ ]"

    if [[ -f "$dest_file" ]]; then
      if is_hardlinked "$dest_file" "$source_file" 2>/dev/null; then
        state="[*]"
      else
        state="[~]"
      fi
    fi

    names+=("$skill_name")
    sources+=("$source_dir")
    states+=("$state")
  done < <(discover_skills "$target_file")

  local -a original_states=("${states[@]}")
  local width
  width=$(term_width)

  while true; do
    clear 2>/dev/null || true
    echo "${BOLD}Skills for $(basename "$PWD")${RESET}"
    echo ""

    local total=${#names[@]}
    local numw=${#total}
    local group="" buf="" i color
    for ((i = 0; i < total; i++)); do
      if [[ "${sources[$i]}" != "$group" ]]; then
        if [[ -n "$buf" ]]; then
          printf '%s' "$buf" | print_grid "$width"
          echo ""
        fi
        buf=""
        group="${sources[$i]}"
        echo "${BOLD}$(shorten "$group")${RESET}"
      fi
      case "${states[$i]}" in
        '[*]') color="$GREEN" ;;
        '[~]') color="$YELLOW" ;;
        *)     color="$DIM" ;;
      esac
      buf="$buf$((numw + 6 + ${#names[$i]}))"$'\t'"${DIM}$(printf "%${numw}d" $((i + 1))))${RESET} $color${states[$i]}$RESET ${names[$i]}"$'\n'
    done
    [[ -n "$buf" ]] && printf '%s' "$buf" | print_grid "$width"

    echo ""
    echo "${DIM}Enter number to toggle, 'a' to apply changes, 'q' to quit${RESET}"
    read -rp "> " input

    case "$input" in
      q|Q) return ;;
      a|A)
        for i in "${!names[@]}"; do
          if [[ "${states[$i]}" != "${original_states[$i]}" ]]; then
            if [[ "${states[$i]}" == "[*]" ]]; then
              cmd_link "${names[$i]}" --target "$target_name"
            else
              cmd_unlink "${names[$i]}" --target "$target_name"
            fi
          fi
        done
        return
        ;;
      *)
        if [[ "$input" =~ ^[0-9]+$ ]] && (( input >= 1 && input <= ${#names[@]} )); then
          local idx=$((input - 1))
          if [[ "${states[$idx]}" == "[*]" ]]; then
            states[$idx]="[ ]"
          else
            states[$idx]="[*]"
          fi
        fi
        ;;
    esac
  done
}

